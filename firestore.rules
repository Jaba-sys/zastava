rules_version = '2';

// MyPeal — вся бизнес-логика выполняется на клиенте (без Cloud Functions,
// чтобы работать на бесплатном Firebase Spark-плане). Эти правила — единственная
// линия защиты, поэтому они строже обычного.

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isAdmin() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true;
    }

    function diffKeys() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    // UID служебного аккаунта @stiller_bot (см. scripts/seedStillerBot.js и
    // web/src/utils/stillerBot.js) — от его имени приходят результаты
    // платных мини-игр /kazik и колеса фортуны в любом чате пользователя.
    function stillerBotUid() {
      return 'lxbfNO7zaZN8bEiQimWFIqKt6383';
    }

    // Фиксированный id системного бота @kazino_bot (см. web/src/utils/
    // kazinoBot.js) — в отличие от stillerBotUid() выше, это НЕ настоящий
    // Firebase Auth UID, а просто зарезервированный id документа bots/{id}
    // (у бота нет живого логина, он существует только в Firestore).
    function kazinoBotId() {
      return 'kazino_bot';
    }

    // Второй участник личного (не групового) чата — считаем, что members
    // всегда ровно 2 элемента для isGroup == false.
    function otherMemberOf(members, me) {
      return members.removeAll([me])[0];
    }

    // Заблокирован ли обмен сообщениями между двумя людьми в этом личном
    // чате (в любую сторону — заблокировать мог как отправитель, так и
    // получатель). Для групп блокировка не применяется.
    function isBlockedInChat(chatId, me) {
      let c = get(/databases/$(database)/documents/chats/$(chatId)).data;
      let other = otherMemberOf(c.members, me);
      return c.isGroup == false
        && (
          exists(/databases/$(database)/documents/blocks/$(me + '_' + other))
          || exists(/databases/$(database)/documents/blocks/$(other + '_' + me))
        );
    }

    // То же самое (кто-то из двоих заблокировал другого), но без привязки к
    // конкретному чату — используется звонками (см. calls/{callId} ниже),
    // у которых нет собственного chatId.
    function isBlockedPair(a, b) {
      return exists(/databases/$(database)/documents/blocks/$(a + '_' + b))
        || exists(/databases/$(database)/documents/blocks/$(b + '_' + a));
    }

    // ---------------------------------------------------------------------
    // Антиспам (см. web/src/utils/antiSpam.js, ChatWindow.jsx -> handleSend)
    // — без Cloud Functions единственная линия защиты те же правила, что и
    // везде в проекте: доверяем клиенту вести отметку времени корректно, но
    // не пускаем ЕЩЁ одно сообщение раньше, чем истёк кулдаун.
    //
    // Простой кулдаун между сообщениями — не чаще одного раза в 2.5 секунды
    // на ЛЮБОЙ чат (личный или групповой), см. users/{uid}.lastMessageAt
    // ниже — защита от скрипта/бота, заваливающего чат потоком сообщений.
    // ---------------------------------------------------------------------
    function floodOk(uid) {
      let lastMessageAt = get(/databases/$(database)/documents/users/$(uid)).data.get('lastMessageAt', null);
      return lastMessageAt == null || request.time > lastMessageAt + duration.value(500, 'ms');
    }

    // Право снести группу целиком (см. web/src/utils/groupDelete.js):
    // владелец группы и администратор. Один get на весь вызов — правила
    // ограничены десятью чтениями на запрос, а удаление сообщений идёт
    // пачками по 400.
    function canDeleteGroup(chatId) {
      let chat = get(/databases/$(database)/documents/chats/$(chatId)).data;
      return chat.isGroup == true
        && (chat.get('ownerId', '') == request.auth.uid || isAdmin());
    }

    // ---------------------------------------------------------------------
    // users/{uid}
    // ---------------------------------------------------------------------
    match /users/{uid} {
      // get — любой авторизованный (поиск по тегу, карточки друзей, чат);
      // list — только админ (иначе кто угодно мог бы выгрузить всю базу пользователей)
      allow get: if isSignedIn();
      allow list: if isAdmin();

      // Документ создаёт сам пользователь, но ТОЛЬКО когда почта уже
      // подтверждена — неподтверждённый аккаунт в базе не появляется вообще
      // (см. web/src/pages/Register.jsx: регистрация создаёт лишь Auth-
      // аккаунт и шлёт письмо, а профиль пишется уже на экране /verify,
      // web/src/pages/VerifyEmail.jsx). Поэтому здесь два и только два
      // допустимых пути, оба с verified:true:
      //   1. request.auth.token.email_verified == true — человек перешёл по
      //      ссылке из письма (флаг ставит сам Firebase Auth, подделать его
      //      клиент не может);
      //   2. валидный одноразовый emailKeyCode на этот же email (см.
      //      emailKeys/{code} ниже, web/src/utils/emailKeys.js) — админский
      //      ключ, законно обходящий ожидание письма. Ключ должен быть
      //      указан в этом же запросе, не отдельным полем позже — иначе
      //      аккаунт можно было бы "довертифицировать" задним числом.
      // Права при создании всё равно "нулевые": админом/с тегом/с готовой
      // анкетой самого себя назначить нельзя.
      allow create: if isOwner(uid)
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.isAdmin == false
        && request.resource.data.banned == false
        && request.resource.data.tag == null
        && request.resource.data.profileComplete == false
        && request.resource.data.verified == true
        && (
          request.auth.token.email_verified == true
          ||
          (request.resource.data.emailKeyCode is string
            && exists(/databases/$(database)/documents/emailKeys/$(request.resource.data.emailKeyCode))
            && get(/databases/$(database)/documents/emailKeys/$(request.resource.data.emailKeyCode)).data.active == true
            && get(/databases/$(database)/documents/emailKeys/$(request.resource.data.emailKeyCode)).data.used == false
            && get(/databases/$(database)/documents/emailKeys/$(request.resource.data.emailKeyCode)).data.email == request.auth.token.email.lower())
        );

      allow update: if isAdmin() || (
        isOwner(uid) && (
          // анкета
          diffKeys().hasOnly(['name', 'bio', 'birthdate', 'profileComplete'])
          ||
          // подтверждение почты — только если у самого Firebase Auth токена
          // уже стоит email_verified (ставится Firebase при переходе по ссылке)
          (diffKeys().hasOnly(['verified'])
            && request.resource.data.verified == true
            && request.auth.token.email_verified == true)
          ||
          // ИЛИ то же самое админским ключом (см. emailKeys/{code} ниже,
          // web/src/utils/emailKeys.js) — на случай, если человек уже начал
          // обычную регистрацию (аккаунт создан, verified:false) ДО того,
          // как ввёл/получил ключ, и теперь застрял на экране /verify —
          // тот же ключ можно применить и здесь, а не только в момент
          // users/{uid} create (см. выше). Условия идентичны той ветке.
          (diffKeys().hasOnly(['verified', 'emailKeyCode'])
            && request.resource.data.verified == true
            && request.resource.data.emailKeyCode is string
            && exists(/databases/$(database)/documents/emailKeys/$(request.resource.data.emailKeyCode))
            && get(/databases/$(database)/documents/emailKeys/$(request.resource.data.emailKeyCode)).data.active == true
            && get(/databases/$(database)/documents/emailKeys/$(request.resource.data.emailKeyCode)).data.used == false
            && get(/databases/$(database)/documents/emailKeys/$(request.resource.data.emailKeyCode)).data.email == request.auth.token.email.lower())
          ||
          // смена email (см. SettingsView.jsx -> verifyBeforeUpdateEmail,
          // contexts/AuthContext.jsx) — сам email в Firebase Auth меняется
          // только когда человек переходит по ссылке подтверждения,
          // присланной на НОВЫЙ адрес; после этого клиент один раз
          // досинхронизирует то же значение сюда. Разрешаем запись, только
          // если новый email РОВНО совпадает с тем, что уже подтвердил сам
          // Auth (request.auth.token.email) — самопровозгласить произвольный
          // email в обход Auth нельзя.
          (diffKeys().hasOnly(['email'])
            && request.resource.data.email == request.auth.token.email)
          ||
          // тег — только если соответствующий tags/{tag} уже "зарезервирован" на этот uid
          (diffKeys().hasOnly(['tag'])
            && exists(/databases/$(database)/documents/tags/$(request.resource.data.tag))
            && get(/databases/$(database)/documents/tags/$(request.resource.data.tag)).data.uid == uid)
          ||
          // heartbeat "онлайн-статуса" — своё поле, без дополнительных проверок
          diffKeys().hasOnly(['lastActive'])
          ||
          // антиспам-кулдаун — метка времени последнего отправленного
          // сообщения (см. messages/{messageId} create ниже -> floodOk(),
          // web/src/utils/antiSpam.js) — своё поле, тот же доверительный
          // уровень, что и heartbeat выше; реальный лимит обеспечивает
          // именно то, что floodOk() читает его перед каждым новым сообщением.
          (diffKeys().hasOnly(['lastMessageAt']) && request.resource.data.lastMessageAt is timestamp)
          ||
          // настройка приватности "принимать заявки в друзья" — своё поле
          diffKeys().hasOnly(['acceptingRequests'])
          ||
          // общий тумблер "не уведомлять меня о новых сообщениях" (см.
          // utils/browserNotify.js) — своё поле, ничего не запрещает и не
          // разрешает, кроме самого клиента слать/не слать браузерные
          // уведомления
          diffKeys().hasOnly(['notificationsMuted'])
          ||
          // персональный фон переписки (см. web/src/utils/wallpapers.js) —
          // переключаться бесплатно можно только на "без фона" или на уже
          // купленный фон, покупка нового — отдельная ветка ниже
          (diffKeys().hasOnly(['chatWallpaper'])
            && (request.resource.data.chatWallpaper == null
              || request.resource.data.chatWallpaper in resource.data.get('ownedWallpapers', [])))
          ||
          // язык интерфейса — выбирается на онбординге (setup-language) и
          // меняется в настройках профиля; ограничиваем набором поддерживаемых кодов
          (diffKeys().hasOnly(['language'])
            && request.resource.data.language in ['ru', 'en', 'uk', 'de'])
          ||
          // звёзды (Stars) и прогресс их заработка — своя область,
          // доверительная модель как и весь остальной проект (нет бэкенда,
          // который мог бы её строго проверить). Единственное реальное
          // ограничение: за один запрос баланс нельзя поднять больше, чем
          // самая крупная разовая награда (см. MAX_STARS_PER_WRITE в
          // web/src/utils/stars.js), и он не может уменьшаться этим правилом.
          (diffKeys().hasOnly(['stars', 'starsProgress'])
            && request.resource.data.get('stars', 0) is int
            && request.resource.data.get('stars', 0) >= resource.data.get('stars', 0)
            && request.resource.data.get('stars', 0) <= resource.data.get('stars', 0) + 100)
          ||
          // покупка стикера (см. web/src/stickers/catalog.js) — звёзды могут
          // только уменьшаться, не больше чем на цену самого дорогого стикера
          // (60), и добавляется ровно один новый id за раз без "оптовых" покупок
          (diffKeys().hasOnly(['stars', 'ownedStickers'])
            && request.resource.data.get('stars', 0) is int
            && request.resource.data.get('stars', 0) <= resource.data.get('stars', 0)
            && request.resource.data.get('stars', 0) >= resource.data.get('stars', 0) - 60
            && request.resource.data.ownedStickers is list
            && request.resource.data.ownedStickers.size() == resource.data.get('ownedStickers', []).size() + 1)
          ||
          // косметика профиля за звёзды (см. web/src/utils/cosmetics.js) —
          // одним правилом покрываем и покупку нового эффекта/цвета/слота
          // аватарки-фотографии (звёзды уменьшаются, не больше чем на 200 —
          // столько стоит самая дорогая косметика, AVATAR_PHOTO_PRICE), и
          // бесплатную смену уже купленного эффекта/аватарки-стикера/режима
          // аватарки sticker↔photo (звёзды тогда не меняются)
          (diffKeys().hasOnly(['stars', 'cosmetics'])
            && request.resource.data.get('stars', 0) is int
            && request.resource.data.get('stars', 0) <= resource.data.get('stars', 0)
            && request.resource.data.get('stars', 0) >= resource.data.get('stars', 0) - 200)
          ||
          // сама фотография аватарки (см. utils/cosmetics.js ->
          // uploadAvatarPhoto) — отдельным полем верхнего уровня, тем же
          // приёмом, что и customWallpaperImage ниже: требует, чтобы слот
          // уже был куплен веткой выше, размер base64-строки ограничен
          (diffKeys().hasOnly(['avatarPhotoImage'])
            && resource.data.get('cosmetics', {}).get('avatarPhotoUnlocked', false) == true
            && request.resource.data.avatarPhotoImage is string
            && request.resource.data.avatarPhotoImage.size() < 200000)
          ||
          // покупка фона переписки (см. web/src/utils/wallpapers.js) —
          // звёзды уменьшаются не больше чем на цену самого дорогого фона
          // (40 — столько стоит фон из своей фотографии), и добавляется
          // ровно один новый ключ за раз
          (diffKeys().hasOnly(['stars', 'ownedWallpapers'])
            && request.resource.data.get('stars', 0) is int
            && request.resource.data.get('stars', 0) <= resource.data.get('stars', 0)
            && request.resource.data.get('stars', 0) >= resource.data.get('stars', 0) - 40
            && request.resource.data.ownedWallpapers is list
            && request.resource.data.ownedWallpapers.size() == resource.data.get('ownedWallpapers', []).size() + 1)
          ||
          // загрузка/замена своей фотографии для фона "custom" (см.
          // wallpapers.js -> uploadCustomWallpaper) — доступно только после
          // покупки слота 'custom' выше, размер base64-строки ограничен,
          // чтобы не раздувать документ пользователя
          (diffKeys().hasOnly(['customWallpaperImage'])
            && 'custom' in resource.data.get('ownedWallpapers', [])
            && request.resource.data.customWallpaperImage is string
            && request.resource.data.customWallpaperImage.size() < 300000)
          ||
          // разблокировка "мой фон видят собеседники" (см. wallpapers.js ->
          // buyWallpaperBroadcast) — платно один раз, не больше 50 звёзд,
          // сразу же и включает саму трансляцию (broadcastWallpaper)
          (diffKeys().hasOnly(['stars', 'wallpaperBroadcastUnlocked', 'broadcastWallpaper'])
            && request.resource.data.get('stars', 0) is int
            && request.resource.data.get('stars', 0) <= resource.data.get('stars', 0)
            && request.resource.data.get('stars', 0) >= resource.data.get('stars', 0) - 50
            && request.resource.data.wallpaperBroadcastUnlocked == true
            && request.resource.data.broadcastWallpaper == true)
          ||
          // включение/выключение уже купленной трансляции фона — бесплатно,
          // но только если разблокировка уже куплена веткой выше
          (diffKeys().hasOnly(['broadcastWallpaper'])
            && resource.data.get('wallpaperBroadcastUnlocked', false) == true)
          ||
          // разблокировка видео в звонках за звёзды (см.
          // web/src/utils/videoCalls.js -> buyVideoCallUnlock) — платно один
          // раз, не больше 250 звёзд; сама кнопка камеры внутри звонка
          // ничего в Firestore не пишет (см. calls/{callId} ниже — SDP уже
          // резервирует видео-канал для обеих сторон), это поле только
          // разрешает СВОЙ клиент показывать кнопку и слать видео
          (diffKeys().hasOnly(['stars', 'videoCallUnlocked'])
            && request.resource.data.get('stars', 0) is int
            && request.resource.data.get('stars', 0) <= resource.data.get('stars', 0)
            && request.resource.data.get('stars', 0) >= resource.data.get('stars', 0) - 250
            && request.resource.data.videoCallUnlocked == true)
          ||
          // разблокировка «аккаунта разработчика» (см. web/src/utils/devAccount.js)
          // — открывает раздел «Разработка» (управление своими ботами, см.
          // bots/{botId} ниже). Платно один раз, не больше 500 звёзд; сама по
          // себе привилегий не даёт — это просто доступ к экрану создания
          // ботов, чьи возможности по-прежнему жёстко ограничены правилами
          // ниже (bots/{botId} create/update).
          (diffKeys().hasOnly(['stars', 'devAccountUnlocked'])
            && request.resource.data.get('stars', 0) is int
            && request.resource.data.get('stars', 0) <= resource.data.get('stars', 0)
            && request.resource.data.get('stars', 0) >= resource.data.get('stars', 0) - 500
            && request.resource.data.devAccountUnlocked == true)
          ||
          // разблокировка платной команды /kazik бота @stiller_bot (см.
          // web/src/utils/stillerBot.js -> buyKazikUnlock) — платно один
          // раз, не больше KAZIK_PRICE (150) звёзд; сама команда — чисто
          // косметическая мини-игра, без реальных призов (см. messages
          // allow create ниже)
          (diffKeys().hasOnly(['stars', 'kazikUnlocked'])
            && request.resource.data.get('stars', 0) is int
            && request.resource.data.get('stars', 0) <= resource.data.get('stars', 0)
            && request.resource.data.get('stars', 0) >= resource.data.get('stars', 0) - 150
            && request.resource.data.kazikUnlocked == true)
          ||
          // разблокировка платного колеса фортуны бота @stiller_bot — тот
          // же паттерн, что и /kazik выше
          (diffKeys().hasOnly(['stars', 'wheelUnlocked'])
            && request.resource.data.get('stars', 0) is int
            && request.resource.data.get('stars', 0) <= resource.data.get('stars', 0)
            && request.resource.data.get('stars', 0) >= resource.data.get('stars', 0) - 150
            && request.resource.data.wheelUnlocked == true)
          ||
          // Покупка платной команды СВОЕГО (с ключом) пользовательского бота
          // (см. utils/customBotCommands.js, botScript.js -> "command ...
          // cost N:") — тот же атомарный паттерн одним документом, что и
          // kazikUnlocked/wheelUnlocked выше: звёзды списываются и отметка
          // о покупке добавляются ОДНИМ writes, поэтому в отличие от
          // botVars/paidCommands ниже здесь не нужна отдельная живая
          // проверка ключа бота — сам факт покупки уже необратимо
          // потрачен, отзыв ключа (см. botKeys/{code}) просто перестаёт
          // пускать в СЛЕДУЮЩИЕ покупки, но не отменяет прошлые (см.
          // обсуждение с пользователем — без возврата звёзд). Максимум
          // списания за раз ограничен потолком цены одной команды
          // (MAX_PAID_COMMAND_COST = 500, см. botScript.js), точная сумма
          // не сверяется — тот же доверительный уровень, что и везде в
          // проекте на бесплатном плане без Cloud Functions.
          (diffKeys().hasOnly(['stars', 'unlockedBotCommands'])
            && request.resource.data.get('stars', 0) is int
            && request.resource.data.get('stars', 0) <= resource.data.get('stars', 0)
            && request.resource.data.get('stars', 0) >= resource.data.get('stars', 0) - 500
            && request.resource.data.unlockedBotCommands is list
            && request.resource.data.unlockedBotCommands.size() == resource.data.get('unlockedBotCommands', []).size() + 1)
          ||
          // "Деп" в казино бота @kazino_bot (см. web/src/utils/kazinoBot.js
          // -> playKazinoDeposit) — ЕДИНСТВЕННОЕ место в проекте, где звёзды
          // по-настоящему разыгрываются в обе стороны за одну операцию (а не
          // просто тратятся на разовую покупку). Ставка — ЛЮБАЯ (не
          // фиксированная), результат уже решён на клиенте до записи (та же
          // доверительная модель без бэкенда, что и везде в проекте) — при
          // проигрыше списываем ставку целиком, при выигрыше начисляем
          // чистую прибыль (возврат ×2 от ставки, из которых половина — это
          // же возвращённая ставка). Диапазон изменения звёзд за один вызов
          // ограничен потолком MAX_CASINO_STAKE (1000, см. kazinoBot.js) —
          // получить больше, даже вызвав это правило напрямую в обход
          // клиента, нельзя.
          (diffKeys().hasOnly(['stars'])
            && request.resource.data.get('stars', 0) is int
            && request.resource.data.get('stars', 0) >= resource.data.get('stars', 0) - 1000
            && request.resource.data.get('stars', 0) <= resource.data.get('stars', 0) + 1000)
          ||
          // покупка подарка себе ИЛИ обналичивание своего подарка (см.
          // web/src/gifts/catalog.js, web/src/utils/gifts.js) — одним
          // правилом покрываем оба сценария: покупка (звёзды уменьшаются не
          // больше чем на цену самого дорогого подарка — 150, подарков
          // становится на 1 больше) и обналичивание (звёзды увеличиваются не
          // больше чем на максимальную выплату — 75, подарков на 1 меньше)
          (diffKeys().hasOnly(['stars', 'ownedGifts'])
            && request.resource.data.get('stars', 0) is int
            && request.resource.data.ownedGifts is list
            && (
              (request.resource.data.get('stars', 0) <= resource.data.get('stars', 0)
                && request.resource.data.get('stars', 0) >= resource.data.get('stars', 0) - 150
                && request.resource.data.ownedGifts.size() == resource.data.get('ownedGifts', []).size() + 1)
              ||
              (request.resource.data.get('stars', 0) >= resource.data.get('stars', 0)
                && request.resource.data.get('stars', 0) <= resource.data.get('stars', 0) + 75
                && request.resource.data.ownedGifts.size() == resource.data.get('ownedGifts', []).size() - 1)
            ))
          ||
          // трата звёзд на подарок другому пользователю или прямой перевод
          // звёзд (см. web/src/utils/gifts.js -> sendGiftToUser/
          // sendStarsToUser) — списание у СЕБЯ, звёзды могут только
          // уменьшаться, не больше чем на самый крупный разовый перевод
          // (MAX_DIRECT_STARS_GIFT = 500). Если аккаунту заблокировали
          // начисление звёзд (starsBlocked), исходящие подарки/переводы
          // тоже запрещены этой же веткой — иначе блокировку можно было бы
          // обойти, просто раздав уже накопленные звёзды кому-то ещё
          // (см. utils/errors.js -> StarsBlockedError). Траты на СЕБЯ
          // (стикеры/косметика/фоны — другие ветки ниже) не затронуты.
          (diffKeys().hasOnly(['stars'])
            && resource.data.get('starsBlocked', false) != true
            && request.resource.data.get('stars', 0) is int
            && request.resource.data.get('stars', 0) <= resource.data.get('stars', 0)
            && request.resource.data.get('stars', 0) >= resource.data.get('stars', 0) - 500)
          ||
          // доверенные устройства для входа (см. utils/deviceTrust.js,
          // contexts/AuthContext.jsx) — за раз можно добавить ровно одно
          // новое устройство (авто-доверие при пустом списке или после
          // одобрения на уже доверенном устройстве), ограничение по размеру
          // списка — просто защита от раздувания документа
          (diffKeys().hasOnly(['trustedDevices'])
            && request.resource.data.trustedDevices is list
            && request.resource.data.trustedDevices.size() <= 20
            && request.resource.data.trustedDevices.size() == resource.data.get('trustedDevices', []).size() + 1)
        )
      ) || (
        // Получение подарка или звёзд от ДРУГОГО пользователя (см.
        // web/src/utils/gifts.js -> sendGiftToUser/sendStarsToUser) —
        // единственный случай, когда НЕ владелец документа может писать в
        // чужой users/{uid}. Осознанный компромисс клиент-доверительной
        // модели: на бесплатном Firebase-плане без Cloud Functions нет
        // способа списать звёзды у отправителя и начислить получателю одной
        // атомарной транзакцией, поэтому это два независимых запроса, и
        // теоретически второй (этот) можно вызвать без первого — риск
        // смягчён тем, что диапазон одного начисления ограничен так же, как
        // и исходящий перевод.
        isSignedIn() && !isOwner(uid) && (
          (diffKeys().hasOnly(['ownedGifts'])
            && request.resource.data.ownedGifts is list
            && request.resource.data.ownedGifts.size() == resource.data.get('ownedGifts', []).size() + 1
            && request.resource.data.ownedGifts[request.resource.data.ownedGifts.size() - 1].fromUid == request.auth.uid)
          ||
          (diffKeys().hasOnly(['stars'])
            && request.resource.data.get('stars', 0) is int
            && request.resource.data.get('stars', 0) >= resource.data.get('stars', 0)
            && request.resource.data.get('stars', 0) <= resource.data.get('stars', 0) + 500)
        )
      );

      allow delete: if false;
    }

    // ---------------------------------------------------------------------
    // bots/{botId} — пользовательские боты (см. web/src/utils/customBots.js,
    // web/src/pages/MyBotsView.jsx). Любой пользователь может завести
    // СВОЕГО бота: имя, тег, набор правил "триггер → ответ" (+ до 4 кнопок
    // быстрого ответа на правило) — никакого произвольного JS, только
    // структурированный конфиг (см. обсуждение с пользователем: реальный
    // JS от чужого бота выполнялся бы в браузере ЛЮБОГО, кто ему пишет —
    // так делать нельзя без бэкенда). botId — обычный автогенерируемый id
    // документа, не обязан быть настоящим Firebase Auth UID (бот никогда не
    // логинится) — его функция ровно та же, что у STARS_BOT_UID/
    // STILLER_BOT_UID: просто ключ, под которым бот "существует" в чатах.
    // Список правил и текст ответов НЕ валидируется глубоко (как и
    // ownedGifts/trustedDevices у users/{uid} выше) — это собственные
    // данные владельца бота, испортить их может только он сам, а
    // ЧУЖИМ пользователям это не даёт никакой привилегии (см. messages
    // allow create ниже — оттуда нельзя написать ничего, кроме текста
    // ответа и кнопок в СВОЙ же личный чат с ботом).
    // ---------------------------------------------------------------------
    match /bots/{botId} {
      allow read: if isSignedIn();

      allow create: if isSignedIn() && (
        (
          // Раздел «Разработка» (создание ботов) платный — см. users/{uid}
          // update -> devAccountUnlocked выше. Без этого поля создать бота
          // нельзя, даже подделав запрос напрямую (не только скрыв кнопку в UI).
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('devAccountUnlocked', false) == true
          && request.resource.data.ownerId == request.auth.uid
          && request.resource.data.tag == null
          && request.resource.data.isBot == true
          && request.resource.data.isCustomBot == true
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.name.size() <= 40
          && request.resource.data.get('rules', []) is list
          && request.resource.data.get('rules', []).size() <= 20
          // Режим "script" (см. web/src/utils/botScript.js) — тот же документ,
          // просто ещё одно текстовое поле рядом с rules (не валидируем
          // синтаксис языка глубоко, как и весь остальной свободный текст в
          // этом документе — безопасность даёт клиентский интерпретатор, не
          // правила). botKeyCode — только через отдельную живую проверку в
          // update ниже, при создании бота ключа ещё быть не может.
          && request.resource.data.get('mode', 'rules') in ['rules', 'script']
          && request.resource.data.get('script', '') is string
          && request.resource.data.get('script', '').size() <= 8000
          && request.resource.data.get('paidCommands', []) is list
          && request.resource.data.get('paidCommands', []).size() <= 10
          && request.resource.data.get('botKeyCode', null) == null
          && request.resource.data.keys().hasOnly(
            ['ownerId', 'tag', 'isBot', 'isCustomBot', 'name', 'bio', 'emoji',
             'rules', 'fallbackReply', 'welcomeReply', 'createdAt', 'updatedAt',
             'mode', 'script', 'botKeyCode', 'paidCommands']
          )
        )
        ||
        (
          // Системный бот @kazino_bot (см. web/src/utils/kazinoBot.js ->
          // ensureKazinoBotExists) — единственный документ с ЗАФИКСИРОВАННЫМ
          // id, никому не принадлежащий (ownerId: null). Любой авторизованный
          // клиент может досоздать его при первом обращении — идемпотентно,
          // Firestore "create" срабатывает только если документа ещё нет,
          // повторно перезаписать уже существующий этим правилом нельзя, а
          // update ниже для него вообще не предусмотрен (ownerId никогда не
          // совпадёт с auth.uid) — не проходит платный пейволл «Разработка»,
          // это не пользовательский бот.
          botId == kazinoBotId()
          && request.resource.data.ownerId == null
          && request.resource.data.tag == kazinoBotId()
          && request.resource.data.isBot == true
          && request.resource.data.isCustomBot == false
          && request.resource.data.isSystemBot == true
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.name.size() <= 40
          && request.resource.data.keys().hasOnly(
            ['ownerId', 'tag', 'isBot', 'isCustomBot', 'isSystemBot', 'name', 'bio', 'emoji', 'createdAt', 'updatedAt']
          )
        )
      );

      allow update: if isSignedIn() && resource.data.ownerId == request.auth.uid && (
        // тег — только если tags/{tag} уже зарезервирован ИМЕННО за этим
        // ботом (см. tags/{tag} ниже — тот же двухшаговый приём, что и у
        // обычных пользователей: сначала резервация тега, потом её
        // подтверждение записью сюда)
        (diffKeys().hasOnly(['tag'])
          && exists(/databases/$(database)/documents/tags/$(request.resource.data.tag))
          && get(/databases/$(database)/documents/tags/$(request.resource.data.tag)).data.uid == botId)
        ||
        // редактирование самого бота — имя/описание/эмодзи/правила ответов,
        // режим и текст скрипта (см. botScript.js), денормализованный список
        // платных команд, извлечённый клиентом из скрипта при сохранении
        // (см. extractPaidCommands в customBots.js) — именно по paidCommands
        // (а не по самому script, который правила не парсят) проверяется
        // покупка платной команды ниже (chats/{chatId} update, messages create)
        (diffKeys().hasOnly(
            ['name', 'bio', 'emoji', 'rules', 'fallbackReply', 'welcomeReply',
             'updatedAt', 'mode', 'script', 'paidCommands']
          )
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.name.size() <= 40
          && request.resource.data.get('rules', []) is list
          && request.resource.data.get('rules', []).size() <= 20
          && request.resource.data.get('mode', 'rules') in ['rules', 'script']
          && request.resource.data.get('script', '') is string
          && request.resource.data.get('script', '').size() <= 8000
          && request.resource.data.get('paidCommands', []) is list
          && request.resource.data.get('paidCommands', []).size() <= 10)
        ||
        // Прикрепление/смена ключа бота (см. botKeys/{code} ниже и
        // web/src/utils/botKeys.js -> attachBotKey) — только владелец бота,
        // и только на код, который админ реально выпустил ИМЕННО под этот
        // botId и который сейчас активен. Живая проверка (get(), не кэш) —
        // те же данные, что и на любой другой момент, поэтому если админ
        // ещё не создал ключ или уже отозвал его, прикрепить/оставить его
        // не получится.
        (diffKeys().hasOnly(['botKeyCode'])
          && (
            request.resource.data.botKeyCode == null
            ||
            (exists(/databases/$(database)/documents/botKeys/$(request.resource.data.botKeyCode))
              && get(/databases/$(database)/documents/botKeys/$(request.resource.data.botKeyCode)).data.botId == botId
              && get(/databases/$(database)/documents/botKeys/$(request.resource.data.botKeyCode)).data.active == true)
          ))
      );

      allow delete: if isSignedIn() && resource.data.ownerId == request.auth.uid;
    }

    // ---------------------------------------------------------------------
    // botKeys/{code} — ключи, отпирающие привилегированные возможности
    // пользовательских ботов (платные команды в скрипте + баннер "бот
    // управляет чатом", см. bots/{botId} выше и chats/{chatId}/messages
    // ниже). Выпускает и отзывает ТОЛЬКО владелец сайта — вручную, через
    // консоль администратора (см. AdminPanel.jsx -> команды botkey
    // create/revoke), никакого самообслуживания. code — короткий человеко-
    // читаемый идентификатор (не сам id документа обязательно совпадает —
    // на практике совпадает, см. botKeys.js), отдаётся владельцу бота вне
    // системы. read — публичный: статус ключа (active) должен быть виден
    // ЛЮБОМУ, кто открыл чат с этим ботом (баннер "бот управляет чатом",
    // проверка перед покупкой платной команды) — документ не содержит
    // ничего чувствительнее botId и флага active.
    // ---------------------------------------------------------------------
    match /botKeys/{code} {
      allow read: if isSignedIn();
      allow create: if isAdmin()
        && request.resource.data.active == true
        && exists(/databases/$(database)/documents/bots/$(request.resource.data.botId))
        && request.resource.data.keys().hasOnly(['botId', 'active', 'createdAt']);
      allow update: if isAdmin() && diffKeys().hasOnly(['active']);
      allow delete: if false;
    }

    // ---------------------------------------------------------------------
    // emailKeys/{code} — ключи обхода ожидания письма-подтверждения ПРИ
    // РЕГИСТРАЦИИ (см. users/{uid} create выше, web/src/utils/emailKeys.js,
    // Register.jsx). Только админ выпускает/отзывает ключ; чтение — тоже
    // только админ (обычный пользователь не должен уметь перечислить чужие
    // выпущенные ключи — сама проверка валидности своего ключа при
    // регистрации идёт через get()/exists() внутри правил выше, это не
    // требует отдельного разрешения на read).
    // ---------------------------------------------------------------------
    match /emailKeys/{code} {
      allow read: if isAdmin();
      allow create: if isAdmin()
        && request.resource.data.active == true
        && request.resource.data.used == false
        && request.resource.data.email is string
        && request.resource.data.email.size() > 0
        && request.resource.data.keys().hasOnly(['email', 'active', 'used', 'createdAt']);
      // Отзыв/повторная активация — только админ. Погашение ("used") —
      // регистрирующийся пользователь, но только синхронно с созданием
      // СВОЕГО users/{uid} с verified:true и совпадающим emailKeyCode
      // (см. выше, оба write в одной атомарной пачке writeBatch) — здесь
      // проверяем email/active/used, остальное уже проверено правилом
      // users/{uid} create в той же пачке.
      allow update: if (isAdmin() && diffKeys().hasOnly(['active']))
        || (isSignedIn()
          && diffKeys().hasOnly(['used'])
          && resource.data.active == true
          && resource.data.used == false
          && resource.data.email == request.auth.token.email.lower()
          && request.resource.data.used == true);
      allow delete: if false;
    }

    // ---------------------------------------------------------------------
    // shortLinks/{code} — ссылки-переходники (см. AdminPanel.jsx -> link
    // create/delete, web/src/utils/shortLinks.js, web/src/pages/ShortLink.jsx
    // — маршрут /r/{code}). Простой публичный редирект на внешний сайт по
    // короткому коду — например, для рекламы/рассылок вне мессенджера.
    // read — ПУБЛИЧНЫЙ (в отличие от botKeys/emailKeys выше): по такой
    // ссылке должен уметь перейти вообще любой человек, даже без аккаунта
    // MyPeal — иначе сам смысл переходника теряется. Документ не содержит
    // ничего чувствительного (только целевой url и служебные поля).
    // Создаёт и удаляет вручную — только администратор через консоль; в
    // отличие от ключей выше здесь нет "отзыва" (active) — только полное
    // удаление навсегда.
    //
    // maxUses/uses — необязательный лимит "только для нескольких
    // пользователей": maxUses == null означает обычный переходник без
    // ограничений (uses всегда остаётся 0 и никогда не растёт). Если
    // maxUses задан, каждый реальный переход по ссылке (ShortLink.jsx,
    // claimShortLinkUse) погашает один "слот" — атомарно увеличивает uses
    // на 1, что и разрешает точечное правило update ниже (публично, без
    // входа в аккаунт — сама страница перехода тоже публичная). Никакой
    // Cloud Function на Spark-плане нет, поэтому "авто-удаление после
    // исчерпания" реализовано прямо в правилах: как только uses достигает
    // maxUses, delete-условие ниже становится истинным для ЛЮБОГО
    // посетителя (не только админа) — клиент, который только что исчерпал
    // последний слот (или любой следующий, кто откроет уже исчерпанную
    // ссылку), сам удаляет документ. Это лучший вариант без серверного кода:
    // между исчерпанием лимита и фактическим удалением возможна короткая
    // задержка (например, если у исчерпавшего лимит пропала сеть до
    // удаления) — до следующего визита ссылка просто будет считаться
    // недействительной (ShortLink.jsx проверяет uses>=maxUses сам), а сама
    // запись подчистится при следующем заходе.
    //
    // showWarning — можно ли пропустить страницу-предупреждение "вы
    // покидаете MyPeal" и сразу редиректить на url. По умолчанию (или
    // если поле отсутствует у переходников, созданных до этой фичи) —
    // true, то есть предупреждение показывается, как и раньше. false —
    // ShortLink.jsx сразу переходит на url без единого клика.
    // ---------------------------------------------------------------------
    match /shortLinks/{code} {
      allow read: if true;
      allow create: if isAdmin()
        && request.resource.data.url is string
        && request.resource.data.url.size() > 0
        && request.resource.data.url.size() <= 2000
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.uses == 0
        && request.resource.data.showWarning is bool
        && (request.resource.data.maxUses == null
          || (request.resource.data.maxUses is int
            && request.resource.data.maxUses > 0
            && request.resource.data.maxUses <= 100000))
        && request.resource.data.keys().hasOnly(['url', 'createdAt', 'createdBy', 'maxUses', 'uses', 'showWarning']);

      // Погашение одного слота лимитированного переходника — публично,
      // но только строго на "+1" и только пока лимит ещё не исчерпан;
      // остальные поля меняться не могут. Для безлимитных переходников
      // (maxUses == null) это правило неприменимо — там update запрещён.
      allow update: if diffKeys().hasOnly(['uses'])
        && resource.data.maxUses != null
        && resource.data.uses < resource.data.maxUses
        && request.resource.data.uses == resource.data.uses + 1;

      allow delete: if isAdmin()
        || (resource.data.maxUses != null && resource.data.uses >= resource.data.maxUses);
    }

    // ---------------------------------------------------------------------
    // tags/{tag} — резервация уникальных @тегов (общая для людей и ботов —
    // см. bots/{botId} выше, поэтому у бота не может быть тега, занятого
    // живым человеком, и наоборот).
    // "create" в терминах правил срабатывает только если документа ещё нет —
    // этим Firestore сам гарантирует уникальность при гонке двух пользователей.
    // ---------------------------------------------------------------------
    match /tags/{tag} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && (
        request.resource.data.uid == request.auth.uid
        ||
        // тег для СВОЕГО бота — владение проверяем через сам bots/{botId}
        (exists(/databases/$(database)/documents/bots/$(request.resource.data.uid))
          && get(/databases/$(database)/documents/bots/$(request.resource.data.uid)).data.ownerId == request.auth.uid)
        ||
        // тег системного бота @kazino_bot — фиксированный, бутстрапится
        // любым авторизованным клиентом (см. web/src/utils/kazinoBot.js ->
        // ensureKazinoBotExists), без проверки владения — у системного
        // бота нет ownerId (идемпотентно: Firestore "create" срабатывает
        // только если tags/kazino_bot ещё не существует).
        (tag == kazinoBotId() && request.resource.data.uid == kazinoBotId())
      );
      allow delete: if isSignedIn() && (
        resource.data.uid == request.auth.uid
        ||
        (exists(/databases/$(database)/documents/bots/$(resource.data.uid))
          && get(/databases/$(database)/documents/bots/$(resource.data.uid)).data.ownerId == request.auth.uid)
      );
      allow update: if false;
    }

    // ---------------------------------------------------------------------
    // friendRequests/{id}
    // ---------------------------------------------------------------------
    match /friendRequests/{requestId} {
      allow read: if isSignedIn()
        && (request.auth.uid == resource.data.from || request.auth.uid == resource.data.to);

      // Получатель мог закрыть приём новых заявок (acceptingRequests == false) —
      // поле необязательное, по умолчанию (отсутствует) считаем как true.
      allow create: if isSignedIn()
        && request.resource.data.from == request.auth.uid
        && request.resource.data.to != request.auth.uid
        && request.resource.data.status == 'pending'
        && get(/databases/$(database)/documents/users/$(request.resource.data.to))
             .data.get('acceptingRequests', true) != false
        // ни одна из сторон не заблокировала другую
        && !exists(/databases/$(database)/documents/blocks/$(request.resource.data.from + '_' + request.resource.data.to))
        && !exists(/databases/$(database)/documents/blocks/$(request.resource.data.to + '_' + request.resource.data.from));

      // отвечать (принять/отклонить) может только получатель, и только один раз
      allow update: if isSignedIn()
        && request.auth.uid == resource.data.to
        && resource.data.status == 'pending'
        && diffKeys().hasOnly(['status'])
        && request.resource.data.status in ['accepted', 'declined'];

      allow delete: if false;
    }

    // ---------------------------------------------------------------------
    // groupInviteLinks/{linkId} — ссылка-приглашение в группу.
    //
    // Пришли на смену вечному адресу /invite/{id группы}: у ссылки есть срок
    // жизни (expiresAt, null — бессрочно), возможный адресат (forUid — тогда
    // ссылка работает только у него) и признак отзыва. Саму проверку этих
    // полей делает правило joinPasses выше — здесь только про то, кто может
    // ссылку создать и отозвать.
    // ---------------------------------------------------------------------
    match /groupInviteLinks/{linkId} {
      // Читать может любой авторизованный: по ссылке надо показать название
      // группы ещё до вступления — ровно так же, как читается сама группа.
      // Номер ссылки при этом угадать нельзя, он случайный.
      allow read: if isSignedIn();

      allow create: if isSignedIn()
        && request.resource.data.keys()
             .hasOnly(['chatId', 'createdBy', 'createdAt', 'expiresAt', 'forUid', 'revoked'])
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.revoked == false
        && request.resource.data.createdAt == request.time
        && (request.resource.data.expiresAt == null
          || request.resource.data.expiresAt > request.time)
        && canInGroupId(request.resource.data.chatId, 'links', true);

      // Отозвать — тот, кто вправе делать ссылки в этой группе. Обратно
      // включить нельзя: отозванная ссылка мертва навсегда, вместо неё
      // делается новая.
      allow update: if isSignedIn()
        && diffKeys().hasOnly(['revoked'])
        && request.resource.data.revoked == true
        && canInGroupId(resource.data.chatId, 'links', true);

      allow delete: if false;
    }

    // ---------------------------------------------------------------------
    // groupInvites/{id} — приглашение в группу для тех, кто НЕ в контактах
    // у приглашающего (для контактов участник добавляется в группу сразу,
    // без этого промежуточного шага — см. правило chats/{chatId} update
    // выше и клиентскую логику в CreateGroup.jsx/ChatWindow.jsx).
    // ---------------------------------------------------------------------
    match /groupInvites/{inviteId} {
      allow read: if isSignedIn()
        && (request.auth.uid == resource.data.from || request.auth.uid == resource.data.to);

      allow create: if isSignedIn()
        && request.resource.data.from == request.auth.uid
        && request.resource.data.to != request.auth.uid
        && request.resource.data.status == 'pending'
        && request.auth.uid in get(/databases/$(database)/documents/chats/$(request.resource.data.chatId)).data.members
        && get(/databases/$(database)/documents/chats/$(request.resource.data.chatId)).data.isGroup == true;

      // ответить (принять/отклонить) может только приглашённый, и только
      // один раз — само добавление в участники группы делает отдельная
      // запись в chats/{chatId} (правило "самостоятельное вступление" выше)
      allow update: if isSignedIn()
        && request.auth.uid == resource.data.to
        && resource.data.status == 'pending'
        && diffKeys().hasOnly(['status'])
        && request.resource.data.status in ['accepted', 'declined'];

      allow delete: if false;
    }

    // ---------------------------------------------------------------------
    // deviceApprovals/{uid}_{deviceId} — "это вы или вас взломали?" (см.
    // utils/deviceTrust.js). Документ полностью "свой": владелец аккаунта —
    // и тот, с чьего нового устройства идёт вход (та же Firebase Auth
    // сессия), и тот, кто подтверждает/блокирует с уже доверенного
    // устройства — поэтому здесь достаточно проверки isOwner, отдельного
    // разрешения на "другое устройство" не требуется (см. комментарий в
    // deviceTrust.js — это слой осведомлённости, не барьер безопасности).
    // ---------------------------------------------------------------------
    match /deviceApprovals/{approvalId} {
      allow read: if isSignedIn() && request.auth.uid == resource.data.uid;

      allow create: if isSignedIn()
        && request.resource.data.uid == request.auth.uid
        && approvalId == request.auth.uid + '_' + request.resource.data.deviceId
        && request.resource.data.status == 'pending';

      // разрешить/заблокировать (с доверенного устройства) либо повторно
      // поставить в 'pending' при повторной попытке входа с уже
      // заблокированного устройства (см. retryDeviceApproval — тот же
      // setDoc целиком перезаписывает документ, включая новый createdAt,
      // поэтому он тоже допустим в диффе, не только status)
      allow update: if isSignedIn()
        && request.auth.uid == resource.data.uid
        && diffKeys().hasOnly(['status', 'createdAt'])
        && request.resource.data.status in ['approved', 'blocked', 'pending'];

      allow delete: if false;
    }

    // ---------------------------------------------------------------------
    // chats/{chatId} — либо личный чат (создаётся при принятии заявки в
    // друзья, members.size() == 2, isGroup == false), либо группа (создаёт
    // любой пользователь, isGroup == true, ownerId — создатель).
    // Админ (isAdmin()) может читать любые чаты и сообщения — экран
    // модерации в разделе "Администрирование".
    // ---------------------------------------------------------------------
    match /chats/{chatId} {
      // Группы читать может кто угодно авторизованный (нужно для превью
      // экрана "Приглашение в группу" по ссылке — /invite/{chatId} — ещё до
      // вступления, см. InviteJoin.jsx). Личные и системные чаты по-прежнему
      // видны только участникам (там members всегда только свои люди).
      allow read: if isSignedIn()
        && (request.auth.uid in resource.data.members || isAdmin() || resource.data.isGroup == true);

      allow create: if (
        isSignedIn()
        && request.auth.uid in request.resource.data.members
        && request.resource.data.members.size() <= 50
        // "system_..." — зарезервированный префикс id для персональных
        // чатов "Системные сообщения" (см. ветку ниже), обычным чатам и
        // группам такой id занимать нельзя.
        && !chatId.matches('^system_.*$')
        && (
          (request.resource.data.isGroup == false && request.resource.data.members.size() == 2)
          ||
          // Группу можно создать и с одним участником (только сам
          // создатель) — если все, кого хотят добавить, не в контактах,
          // CreateGroup.jsx никого не добавляет напрямую в members, а
          // рассылает groupInvites (см. комментарий там же: чужого
          // человека нельзя добавить в группу без согласия). Раньше здесь
          // требовалось members.size() >= 2 для ЛЮБОГО чата, включая
          // группы — это ломало ровно этот сценарий с ошибкой
          // permission-denied. Нижняя граница в 1 участник и так
          // гарантирована условием request.auth.uid in members выше.
          (request.resource.data.isGroup == true
            && request.resource.data.ownerId == request.auth.uid
            && request.resource.data.name is string
            && request.resource.data.name.size() > 0)
        )
      ) || (
        // Персональный "Системные сообщения" — по одному на пользователя,
        // id всегда "system_{uid}". Создать (или досоздать, если ещё нет)
        // может кто угодно авторизованный — единственный участник там
        // всегда сам получатель (systemFor), так что создающему это не
        // даёт никаких дополнительных прав. См. utils/systemChat.js.
        isSignedIn()
        && chatId == 'system_' + request.resource.data.systemFor
        && request.resource.data.isSystem == true
        && request.resource.data.isGroup == false
        && request.resource.data.members == [request.resource.data.systemFor]
        && request.resource.data.keys().hasOnly(
          ['isSystem', 'isGroup', 'systemFor', 'members', 'name', 'createdAt', 'updatedAt', 'lastMessage']
        )
      );

      allow update: if (
        // Админ может выдать/снять синюю галочку подтверждения группе (как в
        // Telegram), даже не будучи участником этой группы — но только это
        // одно поле, остальным управлением группы админ по-прежнему не
        // наделяется через это правило.
        isAdmin() && diffKeys().hasOnly(['verifiedBadge'])
      ) || (
        // Самостоятельное вступление в группу — добавить в members можно
        // только САМОГО СЕБЯ и только предъявив ПРОПУСК
        // chats/{chatId}/joinPasses/{uid}, который пишется шагом раньше и
        // там же проверяется (живая ссылка или принятое приглашение).
        //
        // Раньше эта ветка пускала в любую группу кого угодно: ссылкой был
        // просто адрес с номером группы, вечный и неотзываемый. Теперь без
        // пропуска вступить нельзя вовсе — в том числе по старым ссылкам
        // вида /invite/{id}, и это сознательно: иначе они остались бы
        // лазейкой в обход сроков и отзыва.
        isSignedIn()
        && resource.data.isGroup == true
        && !(request.auth.uid in resource.data.members)
        && diffKeys().hasOnly(['members'])
        && request.resource.data.members == resource.data.members.concat([request.auth.uid])
        && request.resource.data.members.size() <= 50
        // Пропуск должен быть СВЕЖИМ. Если бы хватало самого его наличия,
        // однажды вошедший по ссылке мог бы выйти и вернуться в группу когда
        // угодно — хоть через год, хоть после отзыва ссылки: старый пропуск
        // лежал бы на месте. Пять минут — с запасом на медленную сеть между
        // записью пропуска и вступлением, но не больше.
        && get(/databases/$(database)/documents/chats/$(chatId)/joinPasses/$(request.auth.uid)).data.at
             > request.time - duration.value(5, 'm')
      ) || (
        // Доставка уведомления в ЧУЖОЙ "Системные сообщения" — обновить можно
        // только превью последнего сообщения, сам текст уведомления пишется
        // отдельным правилом в подколлекцию messages ниже.
        isSignedIn()
        && resource.data.isSystem == true
        && diffKeys().hasOnly(['lastMessage', 'updatedAt'])
        && request.resource.data.lastMessage.senderId == request.auth.uid
      ) || (isSignedIn() && request.auth.uid in resource.data.members && (
        // превью последнего сообщения — меняют сами сообщения, разрешено любому участнику
        diffKeys().hasOnly(['lastMessage', 'updatedAt'])
        ||
        // создатель группы переименовывает и/или меняет состав участников
        (resource.data.isGroup == true
          && request.auth.uid == resource.data.ownerId
          && diffKeys().hasOnly(['members', 'name'])
          && request.resource.data.members.size() >= 2
          && request.resource.data.members.size() <= 50
          && request.auth.uid in request.resource.data.members)
        ||
        // Владелец назначает и снимает администраторов и настраивает, что им
        // позволено. Только владелец: иначе администратор мог бы выписать
        // себе любые права или разжаловать владельца.
        (resource.data.isGroup == true
          && request.auth.uid == resource.data.get('ownerId', '')
          && diffKeys().hasOnly(['admins', 'adminRights'])
          && request.resource.data.get('admins', []) is list
          && request.resource.data.get('admins', []).size() <= 20
          // Админом можно сделать только участника группы, и не владельца
          // (он и так может всё). Проверяем именно ДОБАВЛЕННЫХ: если в списке
          // застрял тот, кто из группы уже вышел, это не должно навсегда
          // запереть владельцу настройку прав. Власти у вышедшего всё равно
          // нет — canInGroup отдельно требует членства в группе.
          && request.resource.data.get('admins', [])
               .removeAll(resource.data.get('admins', []))
               .hasOnly(resource.data.members)
          && !request.resource.data.get('admins', [])
               .removeAll(resource.data.get('admins', []))
               .hasAny([resource.data.get('ownerId', '')])
          && request.resource.data.get('adminRights', {}).keys()
               .hasOnly(['links', 'invite', 'calls', 'remove', 'rename']))
        ||
        // Администратор ДОБАВЛЯЕТ участников (право invite). Только
        // добавляет: список обязан целиком содержать прежний, иначе под этой
        // же веткой можно было бы выкинуть кого угодно.
        (resource.data.isGroup == true
          && diffKeys().hasOnly(['members'])
          && canInGroup(resource.data, 'invite', true)
          && resource.data.members.removeAll(request.resource.data.members).size() == 0
          && request.resource.data.members.size() <= 50)
        ||
        // Администратор УДАЛЯЕТ участников (право remove). Только удаляет, и
        // не трогает ни владельца, ни других администраторов — иначе роль
        // легко превращается в захват группы.
        (resource.data.isGroup == true
          && diffKeys().hasOnly(['members'])
          && canInGroup(resource.data, 'remove', false)
          && request.resource.data.members.removeAll(resource.data.members).size() == 0
          && request.resource.data.members.size() >= 2
          && !resource.data.members.removeAll(request.resource.data.members)
                .hasAny([resource.data.get('ownerId', '')])
          && !resource.data.members.removeAll(request.resource.data.members)
                .hasAny(resource.data.get('admins', [])))
        ||
        // Администратор переименовывает группу (право rename).
        (resource.data.isGroup == true
          && diffKeys().hasOnly(['name'])
          && canInGroup(resource.data, 'rename', false)
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.name.size() <= 60)
        ||
        // Владелец группы решает, могут ли обычные участники начинать
        // групповые звонки и звать в них людей (см. groupCalls/{callId} ниже,
        // web/src/utils/groupCalls.js -> canStartGroupCall). По умолчанию
        // поля нет — это значит "только владелец".
        (resource.data.isGroup == true
          && request.auth.uid == resource.data.ownerId
          && diffKeys().hasOnly(['callByMembers'])
          && request.resource.data.callByMembers is bool)
        ||
        // любой участник группы может сам выйти — убрать из members можно только себя
        (resource.data.isGroup == true
          && diffKeys().hasOnly(['members'])
          && request.resource.data.members == resource.data.members.removeAll([request.auth.uid]))
        ||
        // "Очистить историю" — каждый участник чистит только у себя,
        // у собеседника/остальных участников сообщения остаются видны
        (diffKeys().hasOnly(['clearedFor'])
          && request.resource.data.clearedFor.diff(resource.data.get('clearedFor', {})).affectedKeys().hasOnly([request.auth.uid]))
        ||
        // "Удалить чат" — скрыть чат у себя из списка, не удаляя его у других
        (diffKeys().hasOnly(['hiddenFor'])
          && request.resource.data.hiddenFor.diff(resource.data.get('hiddenFor', {})).affectedKeys().hasOnly([request.auth.uid]))
        ||
        // "Удалить чат полностью" — одновременно и очистка истории, и скрытие
        // из списка, обе операции только над своим собственным ключом
        (diffKeys().hasOnly(['clearedFor', 'hiddenFor'])
          && request.resource.data.clearedFor.diff(resource.data.get('clearedFor', {})).affectedKeys().hasOnly([request.auth.uid])
          && request.resource.data.hiddenFor.diff(resource.data.get('hiddenFor', {})).affectedKeys().hasOnly([request.auth.uid]))
        ||
        // "Прочитано" — отметка "досюда я всё прочитал", своим ключом,
        // без дополнительных проверок (как heartbeat онлайн-статуса выше)
        (diffKeys().hasOnly(['lastReadAt'])
          && request.resource.data.lastReadAt.diff(resource.data.get('lastReadAt', {})).affectedKeys().hasOnly([request.auth.uid]))
        ||
        // "Печатает…" — своим ключом, обновляется при каждом нажатии клавиши
        // в поле ввода, поэтому тоже без доп. проверок (пустячное поле)
        (diffKeys().hasOnly(['typing'])
          && request.resource.data.typing.diff(resource.data.get('typing', {})).affectedKeys().hasOnly([request.auth.uid]))
        ||
        // "Без звука" (мут конкретного чата) — своим ключом, тем же
        // паттерном, что и lastReadAt/typing выше. Сам факт мута никак не
        // влияет на доставку/видимость сообщений — только на то, шлёт ли
        // клиент браузерное уведомление (см. utils/browserNotify.js).
        (diffKeys().hasOnly(['mutedFor'])
          && request.resource.data.mutedFor.diff(resource.data.get('mutedFor', {})).affectedKeys().hasOnly([request.auth.uid]))
        ||
        // Переменные скрипта пользовательского бота в режиме "script" (см.
        // botScript.js -> set/get, chats/{chatId}.botVars) — своим личным
        // чатом с ботом может писать только тот, кто в нём состоит; значения
        // не валидируются глубоко (как и rules/script у самого бота выше) —
        // это пространство переменных ТОЛЬКО этого чата, ничего в других
        // документах не меняет и никаких привилегий не даёт.
        (diffKeys().hasOnly(['botVars']) && resource.data.isBotChat == true)
        ||
        // "Очистить чат полностью у обоих" — запрос на обоюдное согласие
        // (только для личных чатов, не групп). Состояния: 'none' (по
        // умолчанию) -> 'pending' (кто-то запросил) -> 'accepted'/'declined'
        // (ответил СОБЕСЕДНИК, не сам инициатор) -> обратно 'none' (после
        // фактической очистки — см. правило messages/{messageId} delete
        // ниже, которое на время status=='accepted' разрешает удалить ЛЮБОЕ
        // сообщение в чате любому из участников, не только своё).
        (resource.data.isGroup == false && (
          // 1. Запросить — можно, если сейчас 'none' или собеседник отклонил
          (diffKeys().hasOnly(['clearRequest'])
            && resource.data.get('clearRequest', {}).get('status', 'none') in ['none', 'declined']
            && request.resource.data.clearRequest.diff(resource.data.get('clearRequest', {})).affectedKeys().hasOnly(['by', 'at', 'status'])
            && request.resource.data.clearRequest.by == request.auth.uid
            && request.resource.data.clearRequest.status == 'pending')
          ||
          // 2. Ответить (принять/отклонить) — только тот, кому адресован
          // запрос, т.е. не сам инициатор
          (diffKeys().hasOnly(['clearRequest'])
            && resource.data.get('clearRequest', {}).get('status', 'none') == 'pending'
            && resource.data.clearRequest.by != request.auth.uid
            && request.resource.data.clearRequest.diff(resource.data.clearRequest).affectedKeys().hasOnly(['status'])
            && request.resource.data.clearRequest.status in ['accepted', 'declined'])
          ||
          // 3. Отменить свой же запрос (пока ждёт ответа) или закрыть уже
          // отклонённый — в обоих случаях обратно в 'none' может увести
          // только сам инициатор (by)
          (diffKeys().hasOnly(['clearRequest'])
            && resource.data.get('clearRequest', {}).get('status', 'none') in ['pending', 'declined']
            && resource.data.clearRequest.by == request.auth.uid
            && request.resource.data.clearRequest.diff(resource.data.clearRequest).affectedKeys().hasOnly(['status'])
            && request.resource.data.clearRequest.status == 'none')
          ||
          // 4. Завершить после согласия — фактическая очистка сообщений
          // делается отдельными запросами delete ниже, а этим шагом сбрасываем
          // статус обратно и обнуляем превью последнего сообщения
          (diffKeys().hasOnly(['clearRequest', 'lastMessage', 'updatedAt'])
            && resource.data.get('clearRequest', {}).get('status', 'none') == 'accepted'
            && request.resource.data.clearRequest.diff(resource.data.clearRequest).affectedKeys().hasOnly(['status'])
            && request.resource.data.clearRequest.status == 'none'
            && request.resource.data.lastMessage == null)
        ))
      ));

      // Удалить группу НАСОВСЕМ и для всех — владелец группы или админ.
      // Личные и системные чаты по-прежнему удалять нельзя: там "удаление" —
      // это скрытие у себя (hiddenFor/clearedFor выше), потому что чат общий
      // и второй человек своей половины переписки не терял.
      // Сообщения удаляются отдельно, до самого чата (см. ветку в
      // messages ниже и web/src/utils/groupDelete.js) — Firestore не удаляет
      // подколлекции вместе с документом.
      allow delete: if isSignedIn()
        && resource.data.isGroup == true
        && (request.auth.uid == resource.data.get('ownerId', '') || isAdmin());

      // ---------------------------------------------------------------
      // joinPasses/{uid} — "пропуск" на вступление в группу.
      //
      // Существует только потому, что правила Firestore не умеют принимать
      // параметр при обновлении документа: проверить предъявленную ссылку
      // прямо в правиле на chats/{chatId} невозможно — оно не знает, какую
      // ссылку человек открыл. Поэтому номер ссылки записывается сюда
      // отдельным документом, здесь же и проверяется, а правило вступления
      // выше просто требует, чтобы пропуск существовал.
      //
      // Перезапись разрешена: человек мог выйти из группы и вернуться позже
      // по новой ссылке — старый пропуск не должен этому мешать.
      // ---------------------------------------------------------------
      match /joinPasses/{uid} {
        allow read: if isSignedIn() && request.auth.uid == uid;

        allow create, update: if isSignedIn()
          && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(['via', 'ref', 'at'])
          && request.resource.data.at == request.time
          && request.resource.data.ref is string
          && (
            (request.resource.data.via == 'link'
              && linkPassOk(request.resource.data.ref, chatId))
            ||
            (request.resource.data.via == 'invite'
              && invitePassOk(request.resource.data.ref, chatId))
          );

        allow delete: if false;
      }

      match /messages/{messageId} {
        allow read: if isSignedIn()
          && (request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.members
            || isAdmin());

        allow create: if (
          isSignedIn()
          && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.members
          && request.resource.data.senderId == request.auth.uid
          && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.banned != true
          && !isBlockedInChat(chatId, request.auth.uid)
          // Антиспам (см. функцию floodOk() выше) — кулдаун между
          // сообщениями, действует на любой чат, личный или групповой.
          && floodOk(request.auth.uid)
        ) || (
          // Системное уведомление в ЧУЖОЙ "Системные сообщения" — заявка в
          // друзья/её принятие/приглашение в группу (от любого пользователя,
          // "про самого себя"), объявление сайта или уведомление о звёздах
          // (начисление/блокировка/разблокировка — только isAdmin(), см.
          // AdminPanel.jsx -> utils/stars.js: grantStars/setStarsBlocked).
          // refId — id соответствующего friendRequests/groupInvites, чтобы
          // прямо в сообщении показать кнопки "Принять/Отклонить" (см.
          // ChatWindow.jsx — SystemActionMessage).
          isSignedIn()
          && get(/databases/$(database)/documents/chats/$(chatId)).data.isSystem == true
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.type in [
               'friend_request', 'friend_accepted', 'group_invite', 'site_update',
               'stars_granted', 'stars_blocked', 'stars_unblocked', 'stars_deducted',
               'gift_received', 'stars_received', 'stars_earned', 'device_login_request'
             ]
          && (request.resource.data.type in ['site_update', 'stars_granted', 'stars_blocked', 'stars_unblocked', 'stars_deducted']
                ? isAdmin()
                : request.resource.data.fromUid == request.auth.uid)
          // pinned — только админ может закреплять рассылку (site_update);
          // anonymous — отмечает подарок/перевод звёзд, отправленный без
          // раскрытия имени (см. utils/gifts.js), само поле не проверяем
          // строго — это лишь подсказка для текста уведомления у получателя;
          // reason — какой именно пассивный способ заработка сработал
          // (stars_earned, см. utils/stars.js -> claimFirstFriendBonus/
          // claimFirstStickerBonus), тоже не проверяем строго — это лишь
          // подсказка, чтобы читатель увидел текст на своём языке
          && (!('pinned' in request.resource.data) || isAdmin())
          && request.resource.data.keys().hasOnly(
            ['type', 'text', 'fromUid', 'fromName', 'chatName', 'refId', 'amount', 'giftId',
             'senderId', 'createdAt', 'pinned', 'anonymous', 'reason']
          )
        ) || (
          // Ответ бота Stars — бэкенда нет, поэтому "от лица бота" сообщение
          // технически пишет сам пользователь (сразу вместе со своим тапом
          // по кнопке, см. utils/stars.js -> sendBotExchange), но строго
          // одним из заранее заданных сценариев с фиксированным key —
          // придумать боту от своего имени что-то произвольное нельзя.
          // daily_bonus/profile_bonus — два новых "активных" способа
          // заработка (claimDailyBonus/claimProfileBonus), тоже кнопками в
          // этом чате.
          isSignedIn()
          && get(/databases/$(database)/documents/chats/$(chatId)).data.isBotChat == true
          && get(/databases/$(database)/documents/chats/$(chatId)).data.botUid == request.resource.data.senderId
          && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.members
          && request.resource.data.type == 'bot_reply'
          && request.resource.data.key in [
               'what_is_this', 'how_to_earn', 'start_earning', 'how_to_buy', 'purchase_requested',
               'daily_bonus', 'profile_bonus'
             ]
          && request.resource.data.keys().hasOnly(['type', 'key', 'text', 'senderId', 'createdAt'])
        ) || (
          // Платные мини-игры бота @stiller_bot — /kazik (казино) и колесо
          // фортуны (см. web/src/utils/stillerBot.js). В отличие от бота
          // Stars выше, это НЕ отдельный "бот-чат" — команды работают в
          // ЛЮБОМ обычном или групповом чате, где сейчас находится
          // пользователь, поэтому проверяем членство в САМОМ этом чате
          // (chatId), а не isBotChat/botUid. "От лица бота" сообщение
          // технически по-прежнему пишет сам вызвавший пользователь
          // (бэкенда нет), но строго одним из двух фиксированных типов и с
          // жёстким белым списком полей — придумать боту произвольный
          // ответ нельзя. Сама покупка команды (kazikUnlocked/
          // wheelUnlocked) проверяется на клиенте — здесь её проверять не
          // нужно: это чисто косметическая анимация без звёзд и призов, а
          // не привилегия, которую стоило бы защищать правилами.
          isSignedIn()
          && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.members
          && request.resource.data.senderId == stillerBotUid()
          && request.resource.data.triggeredBy == request.auth.uid
          && (
            (request.resource.data.type == 'kazik_result'
              && request.resource.data.keys().hasOnly(
                   ['type', 'senderId', 'triggeredBy', 'triggeredByName', 'reels', 'won', 'createdAt']
                 )
              && request.resource.data.reels is list
              && request.resource.data.reels.size() == 3
              && request.resource.data.won is bool
              && request.resource.data.won == (
                   request.resource.data.reels[0] == request.resource.data.reels[1]
                   && request.resource.data.reels[1] == request.resource.data.reels[2]
                 ))
            ||
            (request.resource.data.type == 'wheel_result'
              && request.resource.data.keys().hasOnly(
                   ['type', 'senderId', 'triggeredBy', 'triggeredByName', 'segments', 'resultIndex', 'createdAt']
                 )
              && request.resource.data.segments is list
              && request.resource.data.segments.size() >= 2
              && request.resource.data.segments.size() <= 12
              && request.resource.data.resultIndex is int
              && request.resource.data.resultIndex >= 0
              && request.resource.data.resultIndex < request.resource.data.segments.size())
          )
        ) || (
          // Результат "депа" в казино бота @kazino_bot (см. web/src/utils/
          // kazinoBot.js -> rollKazinoDeposit/sendKazinoDepositResult) —
          // ОТДЕЛЬНЫЙ от @stiller_bot бот (тот теперь только продаёт
          // команды /kazik, /wheel выше, реальных звёзд туда-обратно не
          // двигает). Ставка ЛЮБАЯ (в пределах MAX_CASINO_STAKE = 1000,
          // см. kazinoBot.js), поэтому конкретную сумму заранее не знаем —
          // проверяем только жёсткую связь payout == staked × 2 при
          // выигрыше и 0 при проигрыше, чтобы хотя бы форма сообщения не
          // могла соврать про исход (сама трата/начисление звёзд
          // проверяется отдельно, см. users/{uid} update выше — это два
          // независимых write без общей транзакции, тот же компромисс, что
          // и everywhere без бэкенда).
          isSignedIn()
          && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.members
          && request.resource.data.senderId == kazinoBotId()
          && request.resource.data.triggeredBy == request.auth.uid
          && request.resource.data.type == 'kazino_deposit_result'
          && request.resource.data.keys().hasOnly(
               ['type', 'senderId', 'triggeredBy', 'triggeredByName', 'staked', 'won', 'payout', 'createdAt']
             )
          && request.resource.data.staked is int
          && request.resource.data.staked >= 1
          && request.resource.data.staked <= 1000
          && request.resource.data.won is bool
          && request.resource.data.payout == (request.resource.data.won ? request.resource.data.staked * 2 : 0)
        ) || (
          // Ответ ПОЛЬЗОВАТЕЛЬСКОГО бота (см. bots/{botId} выше и
          // web/src/utils/customBots.js) — тот же приём, что и с ботом
          // Stars: сообщение "от лица бота" технически пишет тот, кто с
          // ним переписывается (бэкенда нет, отвечать некому), но только в
          // СВОЙ личный чат именно с этим ботом (botUid чата) и только
          // фиксированной формой (текст ответа + до 4 кнопок быстрого
          // ответа, см. ChatWindow.jsx). identity бота тут не зашита
          // константой в правила — это же и есть весь смысл
          // самообслуживания: bots/{botId} должен реально существовать,
          // но каким пользователем он создан, не имеет значения — сама
          // возможность посылать сюда что-либо ограничена только "текст +
          // кнопки в свой приватный чат с этим ботом", без единой лазейки
          // к звёздам/правам/чужим данным.
          isSignedIn()
          && get(/databases/$(database)/documents/chats/$(chatId)).data.isBotChat == true
          && get(/databases/$(database)/documents/chats/$(chatId)).data.botUid == request.resource.data.senderId
          && exists(/databases/$(database)/documents/bots/$(request.resource.data.senderId))
          && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.members
          && request.resource.data.type == 'custom_bot_reply'
          && request.resource.data.text is string
          && request.resource.data.text.size() <= 1000
          && request.resource.data.keys().hasOnly(['type', 'text', 'senderId', 'createdAt', 'ruleId', 'buttons'])
          && (!('ruleId' in request.resource.data) || request.resource.data.ruleId is string)
          && (!('buttons' in request.resource.data)
            || (request.resource.data.buttons is list && request.resource.data.buttons.size() <= 4))
        );

        // Удалить сообщение может его автор ("отменить отправку") — или,
        // пока действует принятый обоими "запрос на полную очистку чата"
        // (chats/{chatId}.clearRequest.status == 'accepted', см. выше),
        // любой участник чата может удалить ЛЮБОЕ сообщение — это и есть
        // сама очистка по обоюдному согласию.
        allow delete: if isSignedIn() && (
          resource.data.senderId == request.auth.uid
          ||
          (request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.members
            && get(/databases/$(database)/documents/chats/$(chatId)).data.get('clearRequest', {}).get('status', 'none') == 'accepted')
          ||
          // Снос группы целиком: владелец группы или админ вычищает всю
          // переписку перед удалением самого чата.
          canDeleteGroup(chatId)
        );
        // Редактирование текста — только автор, только у обычного текстового
        // сообщения (без 'type' — сообщения от ботов/системы/мини-игр и т.п.
        // все имеют 'type' и сюда не попадают, см. addDoc-вызовы в
        // ChatWindow.jsx), только поля text/edited/editedAt, новый текст
        // непустой и ограничен длиной (то же, что и при первой отправке
        // текста, см. ChatWindow.jsx -> MAX_MESSAGE_LEN).
        allow update: if isSignedIn()
          && resource.data.senderId == request.auth.uid
          && !('type' in resource.data)
          && diffKeys().hasOnly(['text', 'edited', 'editedAt'])
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 4000
          && request.resource.data.edited == true;
      }
    }

    // ---------------------------------------------------------------------
    // blocks/{blockId} — односторонняя блокировка пользователя. Идентификатор
    // документа всегда "<кто заблокировал>_<кого заблокировали>", поэтому
    // Firestore сам не даёт создать дубликат, а проверить наличие блокировки
    // можно простым exists() по составленному id (см. isBlockedInChat выше).
    // Пока действует блокировка — заблокированный не может писать сообщения
    // и отправлять заявку в друзья тому, кто его заблокировал (и наоборот,
    // пока чат заблокирован — сообщения не идут ни в одну из сторон).
    // ---------------------------------------------------------------------
    match /blocks/{blockId} {
      allow read: if isSignedIn()
        && (request.auth.uid == resource.data.blockerId || request.auth.uid == resource.data.blockedId);

      allow create: if isSignedIn()
        && request.resource.data.blockerId == request.auth.uid
        && request.resource.data.blockedId != request.auth.uid
        && blockId == request.auth.uid + '_' + request.resource.data.blockedId;

      // снять блокировку может только тот, кто её поставил
      allow delete: if isSignedIn() && resource.data.blockerId == request.auth.uid;

      allow update: if false;
    }

    // ---------------------------------------------------------------------
    // contactRemovals/{removalId} — «удалить из друзей» (полноценный разрыв
    // контакта, как в Telegram). В отличие от blocks — переписка и история
    // НЕ трогаются, отправлять сообщения и заявку в друзья не запрещается,
    // единственный эффект: удалённый перестаёт считаться "другом" (не
    // предлагается при создании группы и т.п.) для того, кто его удалил.
    // Идентификатор документа всегда "<кто удалил>_<кого удалили>" — по
    // тому же паттерну, что и blocks/{blockId} выше.
    // ---------------------------------------------------------------------
    match /contactRemovals/{removalId} {
      allow read: if isSignedIn()
        && (request.auth.uid == resource.data.removerId || request.auth.uid == resource.data.removedId);

      allow create: if isSignedIn()
        && request.resource.data.removerId == request.auth.uid
        && request.resource.data.removedId != request.auth.uid
        && removalId == request.auth.uid + '_' + request.resource.data.removedId;

      // снять "удаление из друзей" может только тот, кто его поставил
      // (например при повторной отправке заявки в друзья)
      allow delete: if isSignedIn() && resource.data.removerId == request.auth.uid;

      allow update: if false;
    }

    // ---------------------------------------------------------------------
    // deviceRegistrations/{deviceId} — анти-абьюз: не более одного АККАУНТА
    // на "устройство" (браузер, см. utils/deviceTrust.js -> getDeviceId(),
    // тот же id, что и у подтверждения входа "Это вы?"). При регистрации
    // Register.jsx пытается СОЗДАТЬ документ с этим id — если он уже занят
    // другим аккаунтом, повторная попытка трактуется Firestore как update, а
    // update здесь запрещён, поэтому второй аккаунт с того же браузера
    // создать не получится. Не железная защита (очистка данных сайта или
    // приватное окно снова покажутся новым устройством — тот же компромисс,
    // что и везде в проекте), а барьер против штамповки аккаунтов ради
    // бонусных звёзд (например claimFirstFriendBonus, см. utils/stars.js).
    // ---------------------------------------------------------------------

    // =====================================================================
    // Вход сторонних приложений под аккаунтом MyPeal («Застава» и что будет
    // дальше). Три коллекции, и работают они только вместе.
    //
    // Задача: у приложения свой сайт, а значит своя, отдельная сессия входа —
    // браузер не делится входом между сайтами. Сервера, который выдал бы
    // подпись "это точно он", у нас нет. Поэтому доказательством служит сама
    // запись в базу: выписать пропуск может только вошедший, и только на своё
    // имя (uid == request.auth.uid). Приложение потом предъявляет номер этого
    // пропуска, а правило перечитывает его само и не верит клиенту на слово.
    //
    // Тот же приём, что и joinPasses при вступлении в группу по ссылке:
    // правила не умеют принимать параметр, поэтому параметр кладётся в базу
    // отдельным документом и там же проверяется.
    // =====================================================================

    // Пропуск. Номер случайный и живёт минуты, поэтому читать его разрешено
    // любому вошедшему: угадать номер нельзя, а приложение читает его из
    // СВОЕЙ анонимной сессии, которая про человека ничего не знает.
    // Перебрать коллекцию нельзя — list запрещён, только чтение по номеру.
    match /authTickets/{ticketId} {
      allow get: if isSignedIn();
      allow list: if false;

      allow create: if isSignedIn()
        && request.resource.data.keys().hasOnly(['app', 'uid', 'name', 'tag', 'createdAt', 'expiresAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.app is string
        && request.resource.data.app.size() <= 32
        && request.resource.data.createdAt == request.time
        && request.resource.data.expiresAt > request.time
        // Верхняя граница срока — чтобы нельзя было выписать себе вечный
        // пропуск и раздавать его как пароль.
        && request.resource.data.expiresAt < request.time + duration.value(10, 'm');

      // Погасить пропуск может тот, кто его предъявил, и только один раз.
      // Подсмотренный в чужой адресной строке номер после этого бесполезен.
      allow update: if isSignedIn()
        && diffKeys().hasOnly(['usedBy'])
        && resource.data.get('usedBy', null) == null
        && request.resource.data.usedBy == request.auth.uid
        && resource.data.expiresAt > request.time;

      allow delete: if false;
    }

    // Связка "эта сессия приложения — вот этот человек". Ключ — id анонимной
    // сессии игры. Создать её можно только предъявив живой пропуск, и правило
    // проверяет пропуск само.
    match /authLinks/{sessionUid} {
      allow get: if isSignedIn() && request.auth.uid == sessionUid;
      allow list: if false;

      allow create, update: if isSignedIn()
        && request.auth.uid == sessionUid
        && request.resource.data.keys().hasOnly(['uid', 'ticket', 'at'])
        && request.resource.data.at == request.time
        && request.resource.data.ticket is string
        && authTicketOk(request.resource.data.ticket, request.resource.data.uid);

      // Выход из игры — человек вправе разорвать связку.
      allow delete: if isSignedIn() && request.auth.uid == sessionUid;
    }

    // Карточка игрока: очки, убийства, матчи. Ключ — uid из MyPeal, чтобы
    // статистика была одна на всех устройствах.
    match /gamePlayers/{playerUid} {
      // Читают все вошедшие: имя и счёт нужны в табло матча и в лобби.
      allow read: if isSignedIn();

      allow create: if isSignedIn()
        && actsAsPlayer(playerUid)
        && request.resource.data.keys().hasOnly(
             ['name', 'tag', 'points', 'kills', 'deaths', 'matches', 'createdAt', 'lastPlayedAt'])
        && request.resource.data.points == 0
        && request.resource.data.kills == 0
        && request.resource.data.deaths == 0
        && request.resource.data.matches == 0
        && request.resource.data.createdAt == request.time;

      allow update: if isSignedIn()
        && actsAsPlayer(playerUid)
        && diffKeys().hasOnly(['name', 'tag', 'points', 'kills', 'deaths', 'matches', 'lastPlayedAt'])
        // Счётчики только растут и только на разумную величину за раз: матч
        // идёт восемь минут, тысячи убийств за него не бывает. Это не защита
        // от жульничества (без своего сервера её не сделать), а предохранитель
        // от испорченной таблицы лидеров одной строкой из консоли браузера.
        && request.resource.data.get('kills', 0) >= resource.data.get('kills', 0)
        && request.resource.data.get('kills', 0) <= resource.data.get('kills', 0) + 100
        && request.resource.data.get('deaths', 0) >= resource.data.get('deaths', 0)
        && request.resource.data.get('deaths', 0) <= resource.data.get('deaths', 0) + 100
        && request.resource.data.get('points', 0) >= resource.data.get('points', 0)
        && request.resource.data.get('points', 0) <= resource.data.get('points', 0) + 1000
        && request.resource.data.get('matches', 0) <= resource.data.get('matches', 0) + 1;

      allow delete: if false;
    }

    match /deviceRegistrations/{deviceId} {
      allow read: if isSignedIn() && resource.data.uid == request.auth.uid;

      allow create: if isSignedIn() && request.resource.data.uid == request.auth.uid;

      // Забрать себе ЗАБРОШЕННУЮ отметку. Без этого удаление аккаунта
      // навсегда сжигало браузер: отметка оставалась висеть с уже несуществующим
      // uid, и зарегистрироваться заново с того же устройства человек не мог —
      // повторная запись трактуется Firestore как update, а он был запрещён
      // полностью.
      //
      // Заброшенной считается отметка, у владельца которой НЕТ профиля
      // users/{uid} И которой больше часа. Оба условия нужны вместе:
      //   * нет профиля — аккаунт либо удалён, либо так и не подтвердил почту;
      //   * старше часа — ровно тот срок, после которого неподтверждённый
      //     аккаунт и так подлежит удалению (UNVERIFIED_GRACE_MS в
      //     web/src/utils/pendingAccounts.js, scripts/purgeUnverified.js).
      // Только по "нет профиля" барьер обошёлся бы тривиально: зарегистрировался,
      // не подтвердил почту, тут же регистрируешь следующий аккаунт — и так
      // сколько угодно. С возрастом отметки такой трюк требует часа ожидания на
      // каждый аккаунт, что смысла в нём не оставляет.
      //
      // Отсутствующий createdAt (отметки первых версий) читаем как "очень
      // старая" — такие как раз и надо освобождать.
      allow update: if isSignedIn()
        && request.resource.data.uid == request.auth.uid
        && diffKeys().hasOnly(['uid', 'createdAt'])
        && !exists(/databases/$(database)/documents/users/$(resource.data.uid))
        && resource.data.get('createdAt', timestamp.value(0))
             < request.time - duration.value(1, 'h');

      // Снять ограничение для конкретного устройства (например общий
      // компьютер) может админ вручную — и, отдельным случаем, сам владелец
      // отметки, но ТОЛЬКО пока у него нет профиля users/{uid}, то есть пока
      // аккаунт не подтвердил почту и его как бы не существует (см.
      // web/src/utils/pendingAccounts.js -> deleteUnverifiedAccount).
      // Иначе брошенная регистрация навсегда сжигала бы браузер: отметка
      // осталась бы висеть с уже удалённым uid. Настоящему (подтверждённому)
      // пользователю эта ветка недоступна — профиль у него есть, — поэтому
      // "один аккаунт на браузер" по-прежнему работает.
      allow delete: if isAdmin()
        || (isSignedIn()
          && resource.data.uid == request.auth.uid
          && !exists(/databases/$(database)/documents/users/$(request.auth.uid)));
    }

    // ---------------------------------------------------------------------
    // fileBlobs/{messageId} — байты фото/файлов (base64), отправленных в
    // чатах. Документ доступен на чтение только участникам того чата, к
    // которому относится сообщение — поэтому просто скачать чужой файл по
    // id нельзя. Идентификатор документа всегда совпадает с id самого
    // сообщения в chats/{chatId}/messages/{messageId}.
    // ---------------------------------------------------------------------
    match /fileBlobs/{messageId} {
      allow read: if isSignedIn()
        && (request.auth.uid in get(/databases/$(database)/documents/chats/$(resource.data.chatId)).data.members
          || isAdmin());

      allow create: if isSignedIn()
        && request.resource.data.senderId == request.auth.uid
        && request.auth.uid in get(/databases/$(database)/documents/chats/$(request.resource.data.chatId)).data.members
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.banned != true
        && request.resource.data.data is string
        && request.resource.data.data.size() < 1000000;

      // Тот же принцип, что и для самих сообщений выше: свой файл — всегда,
      // чужой — только пока принят обоюдный "запрос на полную очистку чата".
      allow delete: if isSignedIn() && (
        resource.data.senderId == request.auth.uid
        ||
        (request.auth.uid in get(/databases/$(database)/documents/chats/$(resource.data.chatId)).data.members
          && get(/databases/$(database)/documents/chats/$(resource.data.chatId)).data.get('clearRequest', {}).get('status', 'none') == 'accepted')
      );
      allow update: if false;
    }

    // ---------------------------------------------------------------------
    // calls/{callId} — сигнализация голосовых звонков через WebRTC (см.
    // web/src/contexts/CallContext.jsx). Сами голос/видео идут напрямую
    // между устройствами (peer-to-peer, с STUN/TURN), Firestore используется
    // только чтобы передать друг другу SDP offer/answer и ICE-кандидаты —
    // ровно то же самое ограничение бесплатного плана (нет Cloud Functions,
    // нет отдельного сигнального сервера), что и везде в проекте.
    // ---------------------------------------------------------------------
    match /calls/{callId} {
      allow read: if isSignedIn()
        && (request.auth.uid == resource.data.callerId || request.auth.uid == resource.data.calleeId);

      // Исходящий звонок создаёт только сам звонящий, всегда со статусом
      // 'ringing' и уже готовым SDP-предложением (offer формируется на
      // клиенте до записи в Firestore). Заблокированным друг другом людям
      // звонить нельзя — та же проверка, что и для сообщений.
      allow create: if isSignedIn()
        && request.resource.data.callerId == request.auth.uid
        && request.resource.data.calleeId != request.auth.uid
        && request.resource.data.status == 'ringing'
        && request.resource.data.offer is map
        && !isBlockedPair(request.resource.data.callerId, request.resource.data.calleeId)
        && request.resource.data.keys().hasOnly(
          ['callerId', 'calleeId', 'callerName', 'chatId', 'status', 'offer', 'answer', 'createdAt', 'updatedAt']
        );

      allow update: if isSignedIn() && (
        // получатель отвечает (SDP-ответ) или отклоняет — только пока
        // звонок ещё звонит
        (request.auth.uid == resource.data.calleeId
          && resource.data.status == 'ringing'
          && (
            (diffKeys().hasOnly(['status', 'answer', 'updatedAt'])
              && request.resource.data.status == 'accepted'
              && request.resource.data.answer is map)
            ||
            (diffKeys().hasOnly(['status', 'updatedAt']) && request.resource.data.status == 'declined')
          ))
        ||
        // любая из сторон завершает уже идущий или пропущенный звонок
        ((request.auth.uid == resource.data.callerId || request.auth.uid == resource.data.calleeId)
          && diffKeys().hasOnly(['status', 'updatedAt'])
          && request.resource.data.status in ['ended', 'missed'])
        ||
        // "Я реально вижу видео собеседника" (см. CallContext.jsx ->
        // watchDecodedFrame/watchCameraSent) — каждая сторона пишет ТОЛЬКО
        // своё поле-отметку, когда у себя локально подтвердит, что кадры
        // чужой камеры реально расшифровались. Нужно, чтобы отправляющая
        // сторона могла проверить настоящий факт доставки видео, а не
        // полагаться только на свою локальную статистику отправки (которая
        // может быть "пакеты пошли", даже если до собеседника ничего не
        // дошло — см. комментарий у watchCameraSent).
        (request.auth.uid == resource.data.callerId && diffKeys().hasOnly(['callerSeesVideoAt']))
        ||
        (request.auth.uid == resource.data.calleeId && diffKeys().hasOnly(['calleeSeesVideoAt']))
      );

      allow delete: if false;

      // ICE-кандидаты — отдельными подколлекциями по направлению, чтобы
      // каждая сторона писала только в свою (иначе кто угодно из двоих мог
      // бы подделать маршрут другого). Читают обе стороны звонка — это и
      // есть сам обмен кандидатами.
      match /callerCandidates/{candidateId} {
        allow read: if isSignedIn()
          && (request.auth.uid == get(/databases/$(database)/documents/calls/$(callId)).data.callerId
            || request.auth.uid == get(/databases/$(database)/documents/calls/$(callId)).data.calleeId);
        allow create: if isSignedIn()
          && request.auth.uid == get(/databases/$(database)/documents/calls/$(callId)).data.callerId;
        allow update: if false;
        allow delete: if false;
      }

      match /calleeCandidates/{candidateId} {
        allow read: if isSignedIn()
          && (request.auth.uid == get(/databases/$(database)/documents/calls/$(callId)).data.callerId
            || request.auth.uid == get(/databases/$(database)/documents/calls/$(callId)).data.calleeId);
        allow create: if isSignedIn()
          && request.auth.uid == get(/databases/$(database)/documents/calls/$(callId)).data.calleeId;
        allow update: if false;
        allow delete: if false;
      }
    }

    // ---------------------------------------------------------------------
    // groupCalls/{callId} — групповые звонки в группах (см. web/src/contexts/
    // GroupCallContext.jsx, web/src/utils/groupCalls.js).
    //
    // Модель "комната + дозвон": participants — кто сейчас в звонке, invited —
    // кому звоним прямо сейчас. Пока participants не пуст, звонок live, и
    // любой участник ГРУППЫ может зайти сам, даже если ему не звонили.
    // Начинать звонок и дозваниваться другим может владелец группы, а если он
    // включил chats/{chatId}.callByMembers — то и любой участник.
    //
    // Сигнализация (SDP/ICE) — в подколлекции conns: по документу на каждую
    // попытку соединения пары (id автоматический, см. комментарий там же).
    // Живость участников — в подколлекции presence.
    // ---------------------------------------------------------------------
    function groupCallChat(chatId) {
      return get(/databases/$(database)/documents/chats/$(chatId)).data;
    }

    // Протухла ли отметка присутствия участника (или её нет вовсе). 90 секунд —
    // то же значение, что и STALE_PARTICIPANT_MS в web/src/utils/groupCalls.js;
    // сами отметки пишутся раз в 30 секунд.
    function isStaleInCall(callId, uid) {
      return !exists(/databases/$(database)/documents/groupCalls/$(callId)/presence/$(uid))
        || get(/databases/$(database)/documents/groupCalls/$(callId)/presence/$(uid)).data.at
             < request.time - duration.value(90, 's');
    }

    // -----------------------------------------------------------------
    // Роли в группе: владелец -> администраторы -> участники.
    // Зеркало web/src/utils/groupRoles.js. Владелец назначает админов
    // (chats.admins) и сам решает, что им позволено (chats.adminRights),
    // поэтому "администратор" — это роль с настраиваемым объёмом прав, а не
    // фиксированный набор. Умолчания передаются параметром fallback: у групп,
    // созданных до этой функции, поля adminRights просто нет.
    // -----------------------------------------------------------------
    // -----------------------------------------------------------------
    // Вход сторонних приложений (см. authTickets/authLinks/gamePlayers).
    // -----------------------------------------------------------------

    // Пропуск годен: выписан на этого человека, ещё не истёк и либо не
    // потрачен, либо потрачен этой же сессией (повтор записи не должен
    // ломаться, если первая попытка оборвалась на полпути).
    function authTicketOk(ticketId, uid) {
      let ticket = get(/databases/$(database)/documents/authTickets/$(ticketId)).data;
      return ticket.uid == uid
        && ticket.expiresAt > request.time
        && ticket.get('usedBy', null) in [null, request.auth.uid];
    }

    // Действует ли текущая сессия от имени этого игрока. Либо это он сам в
    // мессенджере, либо сессия приложения, доказавшая связь пропуском.
    function actsAsPlayer(playerUid) {
      return request.auth.uid == playerUid
        || (exists(/databases/$(database)/documents/authLinks/$(request.auth.uid))
          && get(/databases/$(database)/documents/authLinks/$(request.auth.uid)).data.uid == playerUid);
    }

    function isGroupAdminOf(chat, uid) {
      return chat.get('admins', []).hasAny([uid]);
    }

    function canInGroup(chat, key, fallback) {
      return chat.isGroup == true
        && request.auth.uid in chat.members
        && (chat.get('ownerId', '') == request.auth.uid
          || (isGroupAdminOf(chat, request.auth.uid)
            && chat.get('adminRights', {}).get(key, fallback)));
    }

    function canInGroupId(chatId, key, fallback) {
      return canInGroup(get(/databases/$(database)/documents/chats/$(chatId)).data, key, fallback);
    }

    // Пропуск в группу действителен, если ссылка жива: не отозвана, не
    // истекла и — для именной ссылки — предъявлена тем, кому выдана.
    function linkPassOk(linkId, chatId) {
      let l = get(/databases/$(database)/documents/groupInviteLinks/$(linkId)).data;
      return l.chatId == chatId
        && l.get('revoked', false) == false
        && (l.get('expiresAt', null) == null || l.expiresAt > request.time)
        && (l.get('forUid', null) == null || l.forUid == request.auth.uid);
    }

    // Второй способ попасть в группу — принятое именное приглашение по тегу.
    function invitePassOk(inviteId, chatId) {
      let i = get(/databases/$(database)/documents/groupInvites/$(inviteId)).data;
      return i.chatId == chatId && i.to == request.auth.uid && i.status == 'accepted';
    }

    function canStartGroupCall(chatId) {
      let chat = groupCallChat(chatId);
      return chat.isGroup == true
        && request.auth.uid in chat.members
        && (chat.ownerId == request.auth.uid
          || chat.get('callByMembers', false) == true
          // Администратор группы — если владелец оставил ему это право.
          || (isGroupAdminOf(chat, request.auth.uid)
            && chat.get('adminRights', {}).get('calls', true)));
    }

    match /groupCalls/{callId} {
      // Видеть звонок может любой участник группы (плашка "идёт звонок" в
      // чате), а также тот, кому звонят, и тот, кто уже в звонке — последние
      // два случая нужны, чтобы условие проверялось по самому документу, без
      // чтения чата, в запросе "мои входящие".
      allow read: if isSignedIn() && (
        request.auth.uid in resource.data.get('invited', [])
        || request.auth.uid in resource.data.get('participants', [])
        || request.auth.uid in groupCallChat(resource.data.chatId).members
      );

      // Начать звонок: только с правом на это, всегда сам-один в участниках,
      // звать можно только людей из той же группы и не больше лимита.
      allow create: if isSignedIn()
        && request.resource.data.startedBy == request.auth.uid
        && request.resource.data.status == 'live'
        && request.resource.data.participants == [request.auth.uid]
        && request.resource.data.invited is list
        && request.resource.data.invited.hasOnly(groupCallChat(request.resource.data.chatId).members)
        && !(request.auth.uid in request.resource.data.invited)
        && request.resource.data.participants.size() + request.resource.data.invited.size() <= 20
        && canStartGroupCall(request.resource.data.chatId)
        && request.resource.data.keys().hasOnly(
          ['chatId', 'chatName', 'startedBy', 'startedByName', 'status', 'participants', 'invited',
           'createdAt', 'updatedAt']
        );

      allow update: if isSignedIn() && resource.data.status == 'live' && (
        // Войти в звонок — добавить в participants можно только САМОГО СЕБЯ
        // (и заодно убрать себя из invited, если звонили именно мне).
        // Требование быть участником группы — тот же барьер, что и на чтение:
        // по ссылке из чужой группы в звонок не попасть.
        (diffKeys().hasOnly(['participants', 'invited', 'updatedAt'])
          && request.auth.uid in groupCallChat(resource.data.chatId).members
          && !(request.auth.uid in resource.data.participants)
          && request.resource.data.participants == resource.data.participants.concat([request.auth.uid])
          && request.resource.data.participants.size() <= 20
          && request.resource.data.invited == resource.data.invited.removeAll([request.auth.uid]))
        ||
        // Выйти из звонка — убрать из participants можно только себя.
        (diffKeys().hasOnly(['participants', 'updatedAt'])
          && request.auth.uid in resource.data.participants
          && request.resource.data.participants == resource.data.participants.removeAll([request.auth.uid]))
        ||
        // Положить трубку последним — закрыть звонок целиком: убрать себя из
        // participants, перестать дозваниваться остальным и пометить звонок
        // завершённым. БЕЗ ЭТОЙ ВЕТКИ выход последнего участника правилами
        // отклонялся: похожая ветка ниже разрешает закрытие только за
        // "призрака" с протухшей отметкой presence, а живой человек, который
        // прямо сейчас нажал "завершить", под неё не подходит. Запись
        // молча падала (в клиенте она обёрнута в catch), документ оставался
        // status == 'live' — и у тех, кто ещё не присоединился, звонок
        // продолжал "идти": плашка в чате и входящий вызов исчезали только
        // после перезагрузки страницы. Безопасно: закрыть так может только
        // тот, кто сам и есть единственный участник.
        (diffKeys().hasOnly(['participants', 'invited', 'status', 'updatedAt'])
          && request.auth.uid in resource.data.participants
          && resource.data.participants.size() == 1
          && request.resource.data.participants.size() == 0
          && request.resource.data.invited.size() == 0
          && request.resource.data.status == 'ended')
        ||
        // Вычистить "призрака" — участника, который давно не подтверждал, что
        // он здесь (вкладку закрыли, связь пропала; отметки живут в
        // подколлекции presence, см. GroupCallContext.jsx -> writePresence).
        // Может любой участник группы, строго по одному за раз и только если
        // отметка действительно протухла: без этого закрытая вкладка
        // последнего человека оставляла бы группе вечный звонок, который
        // некому закрыть — убрать из participants чужой uid не разрешено
        // ничем другим.
        (diffKeys().hasOnly(['participants', 'updatedAt'])
          && request.auth.uid in groupCallChat(resource.data.chatId).members
          && request.resource.data.participants.size() == resource.data.participants.size() - 1
          && request.resource.data.participants.removeAll(resource.data.participants).size() == 0
          && resource.data.participants.removeAll(request.resource.data.participants).size() == 1
          && isStaleInCall(callId, resource.data.participants.removeAll(request.resource.data.participants)[0]))
        ||
        // ...и то же самое, когда протухший остался последним (или в звонке
        // уже вообще никого нет): звонок сразу закрывается, иначе останется
        // живой пустой "комнатой" с вечной плашкой в чате.
        (diffKeys().hasOnly(['participants', 'invited', 'status', 'updatedAt'])
          && request.auth.uid in groupCallChat(resource.data.chatId).members
          && request.resource.data.participants.size() == 0
          && request.resource.data.invited.size() == 0
          && request.resource.data.status == 'ended'
          && (resource.data.participants.size() == 0
            || (resource.data.participants.size() == 1
              && isStaleInCall(callId, resource.data.participants[0]))))
        ||
        // Завершить звонок ДЛЯ ВСЕХ, не дожидаясь, пока разойдутся остальные.
        // Право на это есть у того, кто звонок начал, и у владельца группы —
        // ровно как и право этот звонок начать. Обычный участник так не может:
        // для него есть простой выход выше, после которого разговор
        // продолжается без него.
        (diffKeys().hasOnly(['participants', 'invited', 'status', 'updatedAt'])
          && request.resource.data.participants.size() == 0
          && request.resource.data.invited.size() == 0
          && request.resource.data.status == 'ended'
          && (request.auth.uid == resource.data.startedBy
            || groupCallChat(resource.data.chatId).ownerId == request.auth.uid
            || isAdmin()))
        ||
        // Отказаться от входящего вызова — убрать из invited только себя (и
        // только если меня реально звали).
        (diffKeys().hasOnly(['invited', 'updatedAt'])
          && request.auth.uid in resource.data.invited
          && request.resource.data.invited == resource.data.invited.removeAll([request.auth.uid]))
        ||
        // Дозвониться ещё кому-то (или перестать дозваниваться) — только тот,
        // кто уже в звонке И имеет право звонить в этой группе; звать можно
        // только людей из той же группы и в пределах лимита.
        (diffKeys().hasOnly(['invited', 'updatedAt'])
          && request.auth.uid in resource.data.participants
          && canStartGroupCall(resource.data.chatId)
          && request.resource.data.invited.hasOnly(groupCallChat(resource.data.chatId).members)
          && request.resource.data.participants.size() + request.resource.data.invited.size() <= 20)
      );

      allow delete: if false;

      // presence/{uid} — "я ещё здесь". Пишет только сам человек и только
      // текущим временем (подделать будущую дату, чтобы стать невычищаемым,
      // нельзя). Читают участники группы — по этим отметкам и вычищаются
      // "призраки" выше.
      match /presence/{uid} {
        allow read: if isSignedIn()
          && request.auth.uid in groupCallChat(get(/databases/$(database)/documents/groupCalls/$(callId)).data.chatId).members;
        allow create, update: if isSignedIn()
          && request.auth.uid == uid
          && request.auth.uid in groupCallChat(get(/databases/$(database)/documents/groupCalls/$(callId)).data.chatId).members
          && request.resource.data.at == request.time
          && request.resource.data.keys().hasOnly(['at']);
        allow delete: if false;
      }

      // conns/{connId} — по документу на КАЖДУЮ ПОПЫТКУ соединения пары
      // участников (id автоматический, не "uidA__uidB": человек может выйти и
      // зайти снова, и тогда ему нужно полностью новое соединение, а не
      // переписанный поверх старый документ — см. GroupCallContext.jsx).
      // Offer пишет тот, чей uid меньше (поле a), answer — второй (поле b).
      // Каждый правит только свою половину, подменить чужой SDP нельзя.
      match /conns/{connId} {
        function callData() {
          return get(/databases/$(database)/documents/groupCalls/$(callId)).data;
        }

        allow read: if isSignedIn() && request.auth.uid in callData().participants;

        allow create: if isSignedIn()
          && request.auth.uid == request.resource.data.a
          && request.resource.data.a in callData().participants
          && request.resource.data.b in callData().participants
          && request.resource.data.a < request.resource.data.b
          && request.resource.data.offer.sdp is string
          && request.resource.data.offer.sdp.size() < 50000
          && request.resource.data.keys().hasOnly(['a', 'b', 'offer', 'createdAt']);

        allow update: if isSignedIn()
          && request.auth.uid in callData().participants
          && (
            (request.auth.uid == resource.data.a && diffKeys().hasOnly(['offer', 'updatedAt'])
              && request.resource.data.offer.sdp.size() < 50000)
            ||
            (request.auth.uid == resource.data.b && diffKeys().hasOnly(['answer', 'updatedAt'])
              && request.resource.data.answer.sdp.size() < 50000)
          );

        allow delete: if false;

        // ICE-кандидаты — своя подколлекция на каждую сторону, чтобы никто не
        // мог подделать маршрут другого. Читают обе стороны этой пары.
        match /aCandidates/{candidateId} {
          function conn() {
            return get(/databases/$(database)/documents/groupCalls/$(callId)/conns/$(connId)).data;
          }
          allow read: if isSignedIn() && (request.auth.uid == conn().a || request.auth.uid == conn().b);
          allow create: if isSignedIn() && request.auth.uid == conn().a
            && request.resource.data.candidate is string
            && request.resource.data.candidate.size() < 1000
            && request.resource.data.keys().hasOnly(['candidate', 'sdpMid', 'sdpMLineIndex', 'usernameFragment']);
          allow update, delete: if false;
        }

        match /bCandidates/{candidateId} {
          function conn() {
            return get(/databases/$(database)/documents/groupCalls/$(callId)/conns/$(connId)).data;
          }
          allow read: if isSignedIn() && (request.auth.uid == conn().a || request.auth.uid == conn().b);
          allow create: if isSignedIn() && request.auth.uid == conn().b
            && request.resource.data.candidate is string
            && request.resource.data.candidate.size() < 1000
            && request.resource.data.keys().hasOnly(['candidate', 'sdpMid', 'sdpMLineIndex', 'usernameFragment']);
          allow update, delete: if false;
        }
      }
    }
  }
}
