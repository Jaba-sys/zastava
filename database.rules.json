// Правила Realtime Database.
// Консоль Firebase -> Realtime Database -> Rules, вставить целиком и Publish.
//
// Главное, что надо знать про эти правила: в Realtime Database право на запись
// НАСЛЕДУЕТСЯ вниз и не отзывается. Если разрешить .write на уровне
// rooms/$room, то любые более строгие правила внутри уже ничего не значат —
// игрок сможет писать и в чужого бойца, и в чужой счёт. Поэтому разрешения тут
// выданы как можно глубже: каждому своё поддерево.
//
// Кто может снести комнату. Раньше — только её создатель. Это давало вечный
// мусор: хозяин уходил, комната оставалась в списке навсегда, потому что
// убрать её было уже некому. Теперь снести комнату может либо создатель (ключ
// его сессии лежит в meta/hostSession), либо ЛЮБОЙ вошедший — но только если в
// комнате не осталось ни одного игрока. Запись в roomIndex устроена так же:
// чужую карточку можно стереть лишь тогда, когда самой комнаты уже нет.
//
// Лимит игроков проверяется тут же, а не только в интерфейсе: data.parent()
// на уровне игрока — это вся ветка players, и её numChildren() даёт текущее
// число вошедших. Без этой проверки в «комнату на двоих» вошло бы сколько
// угодно человек, стоило открыть консоль браузера.
{
  "rules": {
    "roomIndex": {
      ".read": "auth != null",
      "$room": {
        ".write": "auth != null && (!data.exists() || data.child('hostSession').val() === auth.uid || (!newData.exists() && !root.child('rooms').child($room).exists()))",
        ".validate": "!newData.exists() || newData.hasChildren(['map', 'mode', 'host', 'hostSession'])",

        // Пульс и счётчик игроков обновляет любой, кто сидит в комнате:
        // так комната не пропадает из списка, когда хозяин закрыл вкладку.
        "beat":  { ".write": "auth != null", ".validate": "newData.isNumber()" },
        "count": { ".write": "auth != null", ".validate": "newData.isNumber() && newData.val() >= 0" },

        "maxPlayers": { ".validate": "newData.isNumber() && newData.val() >= 2 && newData.val() <= 16" },
        "priv":       { ".validate": "newData.isBoolean()" }
      }
    },

    "rooms": {
      "$room": {
        ".read": "auth != null",

        // снести комнату может создатель — или кто угодно, если она уже пуста
        ".write": "auth != null && data.exists() && !newData.exists() && (data.child('meta/hostSession').val() === auth.uid || !data.child('players').exists())",

        "meta": {
          ".write": "auth != null && (!data.exists() || data.child('hostSession').val() === auth.uid)",
          ".validate": "newData.hasChildren(['map', 'mode'])",
          "maxPlayers": { ".validate": "newData.isNumber() && newData.val() >= 2 && newData.val() <= 16" },
          "priv":       { ".validate": "newData.isBoolean()" }
        },

        "players": {
          "$session": {
            // каждый пишет только в своего бойца — и только если есть место
            ".write": "auth != null && auth.uid === $session && (data.exists() || !newData.exists() || data.parent().numChildren() < (root.child('rooms').child($room).child('meta').child('maxPlayers').exists() ? root.child('rooms').child($room).child('meta').child('maxPlayers').val() : 16))",
            ".validate": "!newData.exists() || (newData.hasChildren(['uid', 'name']) && newData.child('name').val().length <= 40)",
            "hp":     { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100" },
            "kills":  { ".validate": "newData.isNumber() && newData.val() >= 0" },
            "deaths": { ".validate": "newData.isNumber() && newData.val() >= 0" },
            "x":   { ".validate": "newData.isNumber()" },
            "y":   { ".validate": "newData.isNumber()" },
            "z":   { ".validate": "newData.isNumber()" },
            "yaw": { ".validate": "newData.isNumber()" },
            "pitch": { ".validate": "newData.isNumber()" },
            "w": { ".validate": "newData.isString() && newData.val().length <= 12" }
          }
        },

        "events": {
          ".write": "auth != null",
          "$event": {
            ".validate": "!newData.exists() || (newData.hasChildren(['type', 't']) && newData.child('type').val().length <= 12)"
          }
        },

        "chat": {
          "$message": {
            // сообщение можно только добавить: ни переписать, ни стереть чужое
            ".write": "auth != null && !data.exists() && newData.exists()",
            ".validate": "newData.hasChildren(['uid', 'name', 'text']) && newData.child('text').val().length <= 200 && newData.child('text').val().length > 0"
          }
        }
      }
    }
  }
}
