// Правила Realtime Database.
// Консоль Firebase -> Realtime Database -> Rules, вставить целиком и Publish.
//
// Главное, что надо знать про эти правила: в Realtime Database право на запись
// НАСЛЕДУЕТСЯ вниз и не отзывается. Если разрешить .write на уровне
// rooms/$room, то любые более строгие правила внутри уже ничего не значат —
// игрок сможет писать и в чужого бойца, и в чужой счёт. Поэтому разрешения тут
// выданы как можно глубже: каждому своё поддерево.
//
// Кто может снести комнату. Раньше — только её создатель. Это давало вечный
// мусор: хозяин уходил, комната оставалась в списке навсегда, потому что
// убрать её было уже некому. Теперь снести комнату может либо создатель (ключ
// его сессии лежит в meta/hostSession), либо ЛЮБОЙ вошедший — но только если в
// комнате не осталось ни одного игрока. Запись в roomIndex устроена так же:
// чужую карточку можно стереть лишь тогда, когда самой комнаты уже нет.
//
// Чего здесь НЕТ и почему: лимита игроков. Язык правил Realtime Database не
// умеет считать детей узла — numChildren() есть у снимка в клиентской
// библиотеке, но не у RuleDataSnapshot в правилах, и попытка его вызвать
// отвергается редактором ("No such method/property 'numChildren'"). Обойти это
// можно только счётчиком, который ведут сами клиенты, — то есть той же защитой
// на доверии, но с видом настоящей. Поэтому число игроков проверяется в лобби
// и на входе в матч, ровно как и урон: см. раздел README «Что здесь честно, а
// что на доверии».
{
  "rules": {
    "roomIndex": {
      ".read": "auth != null",
      "$room": {
        // Карточку постоянного сервера не стирает никто: его ведут по очереди
        // все, кто в нём есть, и «хозяина» у него нет вовсе.
        ".write": "auth != null && ((data.exists() && data.child('permanent').val() === true && newData.exists()) || !data.exists() || data.child('hostSession').val() === auth.uid || (!newData.exists() && !root.child('rooms').child($room).exists()))",
        ".validate": "!newData.exists() || newData.hasChildren(['map', 'mode', 'host', 'hostSession'])",

        // Пульс и счётчик игроков обновляет любой, кто сидит в комнате:
        // так комната не пропадает из списка, когда хозяин закрыл вкладку.
        "beat":  { ".write": "auth != null", ".validate": "newData.isNumber()" },
        "count": { ".write": "auth != null", ".validate": "newData.isNumber() && newData.val() >= 0" },

        "maxPlayers": { ".validate": "newData.isNumber() && newData.val() >= 2 && newData.val() <= 16" },
        "priv":       { ".validate": "newData.isBoolean()" }
      }
    },

    // Кто сейчас играет и где. Ключ — сессия, а не аккаунт: сверять личность
    // правила умеют только с auth.uid, а он анонимный. Uid из мессенджера идёт
    // полем внутри, и на нём ничего, кроме показа в списке, не держится.
    "presence": {
      ".read": "auth != null",
      "$session": {
        ".write": "auth != null && auth.uid === $session",
        ".validate": "!newData.exists() || (newData.hasChildren(['uid', 'nick']) && newData.child('nick').val().length <= 24)",
        "at":   { ".validate": "newData.isNumber()" },
        "room": { ".validate": "newData.isString() && newData.val().length <= 64" },
        "map":  { ".validate": "newData.isString() && newData.val().length <= 16" },
        "mode": { ".validate": "newData.isString() && newData.val().length <= 8" }
      }
    },

    "rooms": {
      "$room": {
        ".read": "auth != null",

        // Снести комнату может создатель — или кто угодно, если она уже пуста.
        // Постоянную не сносит никто и никогда: она на то и постоянная.
        ".write": "auth != null && data.exists() && !newData.exists() && data.child('meta/permanent').val() !== true && (data.child('meta/hostSession').val() === auth.uid || !data.child('players').exists())",

        "meta": {
          // У постоянного сервера meta правит любой, кто в нём: раунды крутит
          // тот, чей ключ сессии меньше всех, а он меняется сам собой, когда
          // прежний ведущий вышел. Спрашивать разрешения не у кого — своего
          // сервера у игры нет; это та же честность, что и с уроном.
          ".write": "auth != null && (!data.exists() || data.child('hostSession').val() === auth.uid || data.child('permanent').val() === true)",
          ".validate": "newData.hasChildren(['map', 'mode'])",
          "maxPlayers": { ".validate": "newData.isNumber() && newData.val() >= 2 && newData.val() <= 16" },
          "priv":       { ".validate": "newData.isBoolean()" },
          "permanent":  { ".validate": "newData.isBoolean()" },
          "round":      { ".validate": "newData.isNumber() && newData.val() >= 1" },
          "roundEnds":  { ".validate": "newData.isNumber()" },
          "scoreA":     { ".validate": "newData.isNumber() && newData.val() >= 0" },
          "scoreB":     { ".validate": "newData.isNumber() && newData.val() >= 0" }
        },

        "players": {
          "$session": {
            // Каждый пишет только в своего бойца.
            //
            // Лимита игроков ЗДЕСЬ НЕТ, и это не забывчивость. Язык правил
            // Realtime Database не умеет считать детей: numChildren() есть у
            // снимка в клиентской библиотеке, но не у RuleDataSnapshot, а
            // обойти это можно только счётчиком, который ведут сами клиенты, —
            // то есть такой же "защитой на доверии", только с видом настоящей.
            // Поэтому число игроков проверяется в лобби и на входе в матч
            // (net.roomCapacity), ровно как и урон: см. раздел README
            // "Что здесь честно, а что на доверии".
            ".write": "auth != null && auth.uid === $session",
            ".validate": "!newData.exists() || (newData.hasChildren(['uid', 'name']) && newData.child('name').val().length <= 40)",
            "hp":     { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100" },
            "kills":  { ".validate": "newData.isNumber() && newData.val() >= 0" },
            "deaths": { ".validate": "newData.isNumber() && newData.val() >= 0" },
            "x":   { ".validate": "newData.isNumber()" },
            "y":   { ".validate": "newData.isNumber()" },
            "z":   { ".validate": "newData.isNumber()" },
            "yaw": { ".validate": "newData.isNumber()" },
            "pitch": { ".validate": "newData.isNumber()" },
            "w": { ".validate": "newData.isString() && newData.val().length <= 12" }
          }
        },

        "events": {
          ".write": "auth != null",
          "$event": {
            ".validate": "!newData.exists() || (newData.hasChildren(['type', 't']) && newData.child('type').val().length <= 12)"
          }
        },

        "chat": {
          "$message": {
            // сообщение можно только добавить: ни переписать, ни стереть чужое
            ".write": "auth != null && !data.exists() && newData.exists()",
            ".validate": "newData.hasChildren(['uid', 'name', 'text']) && newData.child('text').val().length <= 200 && newData.child('text').val().length > 0"
          }
        }
      }
    }
  }
}
