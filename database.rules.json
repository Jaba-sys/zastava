{
  "//": [
    "Правила Realtime Database. Консоль Firebase -> Realtime Database -> Rules,",
    "вставить целиком и нажать Publish.",
    "",
    "Главное, что надо знать про эти правила: в Realtime Database право на",
    "запись НАСЛЕДУЕТСЯ вниз и не отзывается. Если разрешить .write на уровне",
    "rooms/$room, то любые более строгие правила внутри уже ничего не значат —",
    "игрок сможет писать и в чужого бойца, и в чужой счёт. Поэтому разрешения",
    "тут выданы как можно глубже: каждому своё поддерево.",
    "",
    "Комнату целиком удаляет только тот, кто её создал: ключ его сессии лежит",
    "в meta/hostSession и сверяется с auth.uid. Иначе любой мог бы снести чужой",
    "матч одной строкой из консоли браузера."
  ],

  "rules": {
    "roomIndex": {
      ".read": "auth != null",
      "$room": {
        ".write": "auth != null && (!data.exists() || !newData.exists() || data.child('hostSession').val() === auth.uid)",
        ".validate": "!newData.exists() || newData.hasChildren(['map', 'mode', 'host', 'hostSession'])"
      }
    },

    "rooms": {
      "$room": {
        ".read": "auth != null",

        ".write": "auth != null && data.exists() && !newData.exists() && data.child('meta/hostSession').val() === auth.uid",

        "meta": {
          ".write": "auth != null && (!data.exists() || data.child('hostSession').val() === auth.uid)",
          ".validate": "newData.hasChildren(['map', 'mode'])"
        },

        "players": {
          "$session": {
            ".write": "auth != null && auth.uid === $session",
            ".validate": "!newData.exists() || (newData.hasChildren(['uid', 'name']) && newData.child('name').val().length <= 40)",
            "hp":     { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100" },
            "kills":  { ".validate": "newData.isNumber() && newData.val() >= 0" },
            "deaths": { ".validate": "newData.isNumber() && newData.val() >= 0" },
            "x": { ".validate": "newData.isNumber()" },
            "y": { ".validate": "newData.isNumber()" },
            "z": { ".validate": "newData.isNumber()" },
            "yaw": { ".validate": "newData.isNumber()" }
          }
        },

        "events": {
          ".write": "auth != null",
          "$event": {
            ".validate": "!newData.exists() || (newData.hasChildren(['type', 't']) && newData.child('type').val().length <= 12)"
          }
        },

        "chat": {
          "$message": {
            ".write": "auth != null && !data.exists() && newData.exists()",
            ".validate": "newData.hasChildren(['uid', 'name', 'text']) && newData.child('text').val().length <= 200 && newData.child('text').val().length > 0"
          }
        }
      }
    }
  }
}
