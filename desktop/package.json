{
  "name": "mypeal-desktop",
  "version": "1.0.0",
  "private": true,
  "description": "MyPeal — десктопная обёртка вокруг mypeal.web.app: системные уведомления о сообщениях/звонках, значок в трее, автозапуск с ПК.",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win",
    "dist:mac": "electron-builder --mac",
    "dist:linux": "electron-builder --linux"
  },
  "devDependencies": {
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.mypeal.desktop",
    "productName": "MyPeal",
    "icon": "build/icon.png",
    "directories": { "output": "dist-out" },
    "files": ["src/**/*"],
    "publish": null,
    "win": {
      "target": ["nsis"]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "linux": {
      "target": ["AppImage"],
      "category": "Network;Chat;InstantMessaging"
    },
    "mac": {
      "target": ["dmg"],
      "category": "public.app-category.social-networking"
    }
  }
}
